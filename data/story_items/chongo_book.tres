[resource]
script = ExtResource("2_item")
id = "chongo_book"
display_name = "Chongo's Physics Book"
description = "\"The Boulder Problem: Gravity, Granite, and Everything Else,\" by Chongo. Photocopied, hole-punched, and chalky. Chapter 1 proves that every boulder is just a very slow falling object. Chapter 9 is mostly diagrams of Half Dome. The margins say \"TRUST THE FRICTION.\""
icon = SubResource("AtlasTexture_icon")
