[resource]
script = ExtResource("2_1mfbe")
keeper = "Marty Kessler"
talk_target = "mountain_shop"
greeting = "Welcome to the Mountain Shop. We outfit half the climbers in the Valley. Rope, cams, draws... we take food in trade, same as everyone up here."
nothing_yet = "That's all I can trade you today. Once you've got a rope of your own, come back and I'll round out your rack."
