[resource]
script = ExtResource("2_1mfbe")
keeper = "Marty Kessler"
tastes = "outfitter"
talk_target = "mountain_shop"
greeting = "Welcome to the Mountain Shop. We outfit half the climbers in the Valley. Rope, cams, draws... we take food and goods in trade, same as everyone up here. Food that keeps goes furthest."
nothing_yet = "That's all I can trade you today. Once you've got a rope of your own, come back and I'll round out your rack."
offers = Array[ExtResource("1_7sdry")]([SubResource("Resource_3eq6e"), SubResource("Resource_4xbnm"), SubResource("Resource_vjimg"), SubResource("Resource_hxv0q"), SubResource("Resource_wddds"), SubResource("Resource_nutmid"), SubResource("Resource_nutsml"), SubResource("Resource_cam05"), SubResource("Resource_rope70")])
buys_gear = PackedStringArray("cam", "quickdraw", "belay_device", "climbing_shoes", "chalk_bag", "harness", "rope", "aiders", "ascenders", "haul_bag", "portaledge", "ice_axe", "crampons", "approach_shoes")
buy_rate = 0.5
pays_with = PackedStringArray("cheddar_wedge", "chocolate_bar", "dried_apples")
