[gd_resource type="Resource" script_class="ShopData" format=3]

[ext_resource type="Script" path="res://scripts/shop/shop_offer.gd" id="1_offer"]
[ext_resource type="Script" path="res://scripts/shop/shop_data.gd" id="2_shop"]

[sub_resource type="Resource" id="Resource_adams"]
script = ExtResource("1_offer")
id = "parachute_adams"
price = 36
requires = {
"elk_hair_caddis": 1
}
max_owned = 1

[sub_resource type="Resource" id="Resource_bugger"]
script = ExtResource("1_offer")
id = "woolly_bugger"
trade = {
"brown_trout": 2
}
requires = {
"parachute_adams": 1
}
max_owned = 1

[sub_resource type="Resource" id="Resource_wulff"]
script = ExtResource("1_offer")
id = "royal_wulff"
trade = {
"brook_trout": 2
}
requires = {
"woolly_bugger": 1
}
max_owned = 1

[resource]
script = ExtResource("2_shop")
keeper = "Greg"
offers = Array[ExtResource("1_offer")]([SubResource("Resource_adams"), SubResource("Resource_bugger"), SubResource("Resource_wulff")])
