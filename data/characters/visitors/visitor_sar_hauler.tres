[resource]
script = ExtResource("1_s")
id = "visitor_sar_hauler"
display_name = "Rescue volunteer"
years = "1970s"
affiliation = "Camp 4 rescue site"
bio = "A search and rescue volunteer from the Camp 4 site, good with a map and better on the end of a litter. Not a historical figure."
idle_lines = PackedStringArray("Litter carries are the real work. Six people, one stretcher, three miles of switchbacks.", "Most of our calls are hikers on the trails, not climbers. Tired, thirsty, and a little lost.", "Map, headlamp, water, and something to eat. Everybody who goes out on a call carries those four.")
sprite_sheet = ExtResource("2_sprite")
home = "Camp 4, at the rescue site"
visitor = true
