id = "huff_rico"
display_name = "Rico"
years = "today"
affiliation = "Park visitor"
bio = "A Curry Village Pizza Deck cook living in the Huff employee tents behind the village. Hauls two beat-up speakers into the woods after ten."
idle_lines = PackedStringArray("Two hundred pizzas on a Saturday night, then we haul the speakers into the pines. That's the Huff life.", "Welcome to Huff. Tent cabins with thinner canvas and louder neighbors than Curry Village.", "If you're still up past ten, listen for the bass off-trail. We never throw it in the same boulders twice.", "Don't leave snacks in your tent here. Bears know the difference between guest tents and employee tents: ours have better hot sauce.")
