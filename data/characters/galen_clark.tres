[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://scripts/story/character_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/sprites/npcs/galen_clark.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "galen_clark"
display_name = "Galen Clark"
years = "1814–1910"
affiliation = "Guardian of the Yosemite Grant"
bio = "Came to California in 1853 and homesteaded at Wawona in 1856, where Clark's Station fed and housed travelers on the way to the valley. In 1866 the state named him the first Guardian of the Yosemite Grant. He is remembered as a protector of the valley and the Mariposa Grove, and he is also part of the history of how the valley was taken from the people who lived here."
legacy = "The first Guardian of the Yosemite Grant (1866). He kept the valley and the Mariposa Grove for the State under the 1864 Grant, the first land the federal government set aside for public use."
legacy_year = 1866
idle_lines = PackedStringArray("Write down what people tell you, and who told you. The who matters as much as the what.", "I was given this job by the State of California. The valley had keepers long before that.")
story_beats = [{"after": "shop_guidebook", "lines": ["A guidebook! So now you carry two books: one for the walls and one for the people. You may find they turn into the same book, after a while."]}, {"after": "partner_apron", "lines": ["Your first tick, I hear. Lamon saw you on the Apron from his orchard and came to tell me.", "I've never been up a rope in my life. Walking was my climbing. My first summer at Wawona I went over every foot of the Mariposa Grove, counting the big trees."]}, {"after": "eichorn_apron", "lines": ["You've stood on Glacier Point, then. Mr. McCauley charges a toll on his trail, so you came up the cheap way.", "From up there you can see how the whole valley fits together. Mind you, the people who lived here never needed the view to know that."]}, {"after": "robbins_clean", "lines": ["Mr. Robbins says to leave no mark. I've been chewing on that.", "The surveyors put my name on a peak east of here: Mount Clark. Every peak in sight had a name long before the surveyors came. Mine was only the one they wrote down."]}, {"after": "salathe_steel", "lines": ["Mr. Salathé showed me his pitons. Car axles! When I came, the only steel in this valley was a sawmill blade and the shoes on the stage horses."]}, {"after": "harding_summit", "lines": ["They say the whole valley watched you on El Capitan: little lights on the wall at night. I watched too.", "The Tioga Road's open to you now. Up there you'll be on the old trails over the crest. People were crossing those passes to trade and visit long before any road. Listen for that."]}, {"after": "muir_glacier", "lines": ["John Muir sent you down? Then the book's nearly full.", "Before you bring it to me, make sure everyone who wanted to be heard has been. Not everybody walks up to the gate."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.227, 0.227, 0.259, 1)
home = "Lamon Homestead gate"
needs_tribal_review = false
sources = "To verify: NPS Yosemite history pages; Shirley Sargent, Galen Clark: Yosemite Guardian (1964); the Yosemite Grant Act (June 30, 1864), whose 'public use, resort and recreation' wording Clark quotes. Also to verify: that he came to the mountains in 1856 after a lung illness expecting to die (his own telling, often repeated), his 1857 survey of the Mariposa Grove, and Mount Clark being named for him by the state Geological Survey. The Register, his story beats, and the epilogue are dramatized."
