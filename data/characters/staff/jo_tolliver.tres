[resource]
script = ExtResource("1_s")
id = "jo_tolliver"
display_name = "Jo Tolliver"
years = "1970s"
affiliation = "Camp 4 rescue site"
bio = "Climber, litter-hauler and keeper of the radio at the Camp 4 rescue site, where climbers camp in return for answering the park's rescue calls. An invented character, not a historical figure."
idle_lines = PackedStringArray("Everybody gets found. That's the only rule I care about.", "Most rescues aren't on El Cap. They're a tired hiker on a trail at dusk, with no water and no flashlight.", "Read the ground. A heel print digs in going downhill, a toe print going up. Prints will tell you where somebody's going and how tired they are.", "Lowering's all in the brake hand. Smooth is fast. Fast is bumpy.", "If the radio goes off, I'll be right here. I'm always right here.")
rare_lines = PackedStringArray("My first carry-out, I was so nervous I tied the litter in twice. The guy on it said it was the safest he'd felt all day.")
rare_after_quest = "jo_first_call"
sprite_sheet = ExtResource("2_sprite")
color = Color(0.847, 0.416, 0.165, 1)
home = "Camp 4, at the rescue site"
staff = true
sources = "Invented for the game. Climbers camped at the Camp 4 rescue site have helped Yosemite Search and Rescue since the 1970s; the calls here are made up, and in the game everyone is found."
