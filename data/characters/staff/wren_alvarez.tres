[resource]
script = ExtResource("1_s")
id = "wren_alvarez"
display_name = "Wren Alvarez"
years = "1970s"
affiliation = "Curry Village Mountain Shop (new hire)"
bio = "Started at the Mountain Shop this week. Climbed every weekend back home, but doesn't know anyone in the Valley yet. An invented character, not a historical figure."
idle_lines = PackedStringArray("Heels low, trust the rubber. That's all slab is. Well, that and not looking down.", "Marty says I'm allowed to climb on my lunch break if I'm back by one. I have never once been back by one.", "Everybody here talks about El Cap. I just want to learn every slab on the Apron first.")
story_beats = [{"after": "robbins_clean", "lines": ["You climbed with Royal Robbins? THE Royal Robbins? Marty's going to want an autograph for the shop wall."]}, {"after": "harding_summit", "lines": ["You climbed the Nose. Free. I belayed you on a 5.5 like three months ago! I'm telling everyone I taught you everything.", "...I didn't teach you everything."]}, {"after": "clark_last_page", "lines": ["So the old guy's book is done? What's next for you?", "Whatever it is, the Apron's still here on your days off. I'll bring the rope."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.29, 0.541, 0.541, 1)
home = "Curry Village, foot of Firefall Slab"
staff = true
sources = "Invented for the game."
