[ext_resource type="Texture2D" path="res://assets/sprites/npcs/warren_harding.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "warren_harding"
display_name = "Warren Harding"
years = "1924–2002"
affiliation = "Climber"
bio = "Led the first ascent of the Nose of El Capitan, finished in November 1958 after 47 climbing days spread over about 18 months. His team fixed ropes up the wall and pushed higher each time, a style later called 'siege' climbing."
idle_lines = PackedStringArray("Everyone said El Cap couldn't be climbed. Then we climbed it.", "Bring more food than you think. Then bring more again.")
story_beats = [{"after": "muir_cathedral", "lines": ["How's the high country? Muir still out there talking to the trees? Not a bolt in that whole range, I'll bet. Doesn't seem natural."]}, {"after": "clark_last_page", "lines": ["You finished the old man's book? Did you put me in it? Put the wine in. History should know about the wine."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.659, 0.227, 0.165, 1)
home = "El Capitan Meadow"
needs_tribal_review = false
sources = "To verify: Warren Harding, Downward Bound (1975); Steve Roper, Camp 4 (1994). The summit lines paraphrase Harding's own account of topping out on November 12, 1958, after drilling bolts up the final headwall through the night ('not at all clear to me who was conqueror and who was conquered'; El Cap 'in much better condition than I was'). Daring the player to climb it free is dramatized."
