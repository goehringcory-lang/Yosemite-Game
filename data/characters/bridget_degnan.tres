[resource]
script = ExtResource("1_s")
id = "bridget_degnan"
display_name = "Bridget Degnan"
years = ""
affiliation = "Degnan's Bakery"
bio = "Irish-born baker who, with her husband John, settled in the valley in 1884. She began baking bread in her own kitchen for visitors and workers, and the family business grew into Degnan's bakery and store, which ran in the valley for generations."
idle_lines = PackedStringArray("Bread doesn't wait for anybody. Neither do hungry climbers.", "Sixty loaves before sunrise, and they'll all be gone by noon.")
sprite_sheet = ExtResource("2_sprite")
color = Color(0.290, 0.416, 0.541, 1)
home = "Degnan's Bakery, Yosemite Village"
needs_tribal_review = false
sources = "To verify: Yosemite Museum records; Hank Johnston, Yosemite's Yesterdays; dates not yet confirmed."
