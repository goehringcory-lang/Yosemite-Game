[ext_resource type="Texture2D" path="res://assets/sprites/npcs/clare_hodges.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "clare_hodges"
display_name = "Clare Marie Hodges"
years = "1890–1970"
affiliation = "National Park Service"
bio = "Hired in 1918 as Yosemite's first woman ranger, during World War I when many men had gone to war. She patrolled the valley on horseback."
legacy = "Yosemite's first woman ranger (1918), patrolling the valley on horseback in the National Park Service's first years."
legacy_year = 1918
idle_lines = PackedStringArray("They said a woman couldn't do the job. I had a horse and a hat, same as anybody.", "Keep your food packed away. Bears learn faster than visitors.")
story_beats = [{"after": "salathe_steel", "lines": ["One of my rangers found that old wreck at El Portal with an axle gone. Nothing else touched. Whoever took it knew exactly what they wanted, and why.", "I've filed it under the Guardian, for want of anywhere better. That file's getting thick, and it still has no name on it."]}, {"after": "clark_last_page", "lines": ["Mr. Clark's book is done? Good. I'll keep it in mind next to the bird counts. In fifty years somebody will want to know who was here, and what they said."]}, {"after": "lost_guardian", "lines": ["I had every Guardian on the State's list, and I told you none of them was lost. I was right, too. I just never thought to look at who was standing in my office asking.", "I'll have to add a name to the file. Don't let it go to your head."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.478, 0.447, 0.282, 1)
home = "Ranger station, Yosemite Village"
needs_tribal_review = false
sources = "To verify: NPS Yosemite history; NPS women in parks history."
