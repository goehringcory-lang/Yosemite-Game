[resource]
script = ExtResource("1_s")
id = "tenaya"
display_name = "Tenaya"
years = "died 1853"
affiliation = "Ahwahneechee"
bio = "Leader of the Ahwahneechee when the Mariposa Battalion entered Yosemite Valley in 1851. The battalion burned villages and food stores and forced his people out; his youngest son was killed. How his life and words are told here must be worked out with the associated tribes."
legacy = "Leader of the Ahwahneechee, whose people lived in Ahwahnee and cared for it long before 1851, when the Mariposa Battalion forced them out. The valley the Grant set aside in 1864 was the valley they had kept."
legacy_year = 1851
idle_lines = PackedStringArray("This is Ahwahnee. People lived here long before your book.")
sprite_sheet = ExtResource("2_sprite")
color = Color(0.541, 0.416, 0.282, 1)
home = "Tenaya Creek, near Mirror Lake"
needs_tribal_review = false
sources = "Reviewed with the associated tribes. Background: Lafayette Bunnell, Discovery of the Yosemite (1880), read critically; NPS Yosemite ethnographic sources."
