home = "Tenaya Creek, near Mirror Lake"
needs_tribal_review = true
sources = "Placeholder pending tribal review. Background to verify with tribal advisors: Lafayette Bunnell, Discovery of the Yosemite (1880), read critically; NPS Yosemite ethnographic sources."
