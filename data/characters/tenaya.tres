id = "tenaya"
display_name = "Tenaya"
years = "died 1853"
affiliation = "Ahwahneechee"
bio = "Leader of the Ahwahneechee when the Mariposa Battalion entered Yosemite Valley in 1851. The battalion burned villages and food stores and forced his people out; his youngest son was killed. How his life and words are told here must be worked out with the associated tribes."
idle_lines = PackedStringArray("This is Ahwahnee. People lived here long before your book.")
