[resource]
script = ExtResource("1_s")
id = "maria_lebrado"
display_name = "Maria Lebrado (Totuya)"
years = "c. 1840–1931"
affiliation = "Ahwahneechee"
bio = "Granddaughter of Tenaya. She was a girl in the valley in 1851 when the Mariposa Battalion forced her people out. In 1929 she returned and identified the sites of villages, and her memories changed how the park recorded its own history."
legacy = "Tenaya's granddaughter. In 1929 she came back and showed where the villages had stood, and the park's record of its own history changed because of her."
legacy_year = 1929
idle_lines = PackedStringArray("I was a girl when they came. I remember where everything was.")
sprite_sheet = ExtResource("2_sprite")
color = Color(0.165, 0.165, 0.188, 1)
home = "The meadow by the Ahwahnee"
needs_tribal_review = false
sources = "Reviewed with the associated tribes. NPS records of the 1929 visit; Yosemite Nature Notes (1929)."
