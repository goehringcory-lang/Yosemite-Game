[resource]
script = ExtResource("1_s")
id = "george_anderson"
display_name = "George Anderson"
years = "died 1884"
affiliation = "Blacksmith and trail builder"
bio = "Scottish-born blacksmith who made the first recorded ascent of Half Dome in October 1875. He drilled holes up the smooth granite, set iron eyebolts, and tied a rope between them. Others used his rope soon after, and later cables followed his line."
legacy = "Made the first recorded ascent of Half Dome (1875), drilling a line of eyebolts up the back. The cables that followed his line take thousands of people up every summer."
legacy_year = 1875
idle_lines = PackedStringArray("Drill, bolt, step, drill again. It's slow, but it goes.", "They said nobody would ever stand on top of it.")
story_beats = [{"after": "clark_last_page", "lines": ["So Clark's book is done. Mine's a line of holes up the back of the Dome. Yours is a good deal easier to read, and it doesn't rust."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.478, 0.165, 0.165, 1)
home = "Happy Isles"
needs_tribal_review = false
sources = "To verify: NPS Half Dome history; Yosemite Nature Notes."
