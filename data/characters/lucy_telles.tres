[resource]
script = ExtResource("1_s")
id = "lucy_telles"
display_name = "Lucy Telles"
years = "c. 1885–1955"
affiliation = "Mono Lake Paiute / Southern Sierra Miwuk"
bio = "Renowned basket weaver who demonstrated at the Yosemite Museum for many years. Between 1929 and 1933 she wove one of the largest baskets of its kind, now in the museum's collection."
legacy = "Demonstrated weaving at the Yosemite Museum for many years. The basket she wove from 1929 to 1933 is one of the largest of its kind, and it's still in the Museum."
legacy_year = 1929
idle_lines = PackedStringArray("Sit a while. Some things you learn by watching.")
sprite_sheet = ExtResource("2_sprite")
color = Color(0.478, 0.227, 0.290, 1)
home = "Yosemite Museum"
needs_tribal_review = true
sources = "Placeholder pending tribal review. To verify with tribal advisors and the Yosemite Museum: Craig Bates and Martha Lee, Tradition and Innovation: A Basket History of the Indians of the Yosemite–Mono Lake Area (1990)."
