[ext_resource type="Script" path="res://scripts/story/character_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/sprites/npcs/ansel_adams.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "ansel_adams"
display_name = "Ansel Adams"
years = "1902–1984"
affiliation = "Sierra Club; Best's Studio"
bio = "Photographer who first came to Yosemite as a boy in 1916. In 1927 he made 'Monolith, the Face of Half Dome' from the Diving Board. He married Virginia Best, whose father ran Best's Studio in the valley, and was a longtime Sierra Club leader."
legacy = "Photographed Yosemite from 1916 on. His pictures helped persuade Congress to create Kings Canyon National Park (1940), and he served on the Sierra Club's board for decades."
legacy_year = 1916
idle_lines = PackedStringArray("The light changes every minute. You learn to wait.", "Jules had the best hands of any student I taught. Then he found rock climbing.")
story_beats = [{"after": "johnson_astroman", "lines": ["I had the camera on Washington Column last evening and caught a climber high on the face, right in the last light.", "I've printed it three times and I still can't make out the face. Everyone who sees it says that's the Guardian.", "I'm not so sure. It looks a bit like you."]}, {"after": "clark_last_page", "lines": ["The Register's finished? Then you've done what I keep trying to do with a camera: get the whole valley onto paper.", "My pictures mostly leave the people out. Yours doesn't. I've been thinking about that."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.227, 0.227, 0.220, 1)
home = "Best's Studio, Yosemite Village"
needs_tribal_review = false
sources = "To verify: Ansel Adams, An Autobiography (1985); Ansel Adams Gallery history."
