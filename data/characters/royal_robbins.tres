[resource]
script = ExtResource("1_s")
id = "royal_robbins"
display_name = "Royal Robbins"
years = "1935–2017"
affiliation = "Climber"
bio = "Led the first ascent of the Northwest Face of Half Dome in 1957, the first Grade VI climb in the country. In the late 1960s and 70s he championed clean climbing: protection that could be placed and removed without scarring the rock."
legacy = "Led the first ascent of Half Dome's Northwest Face (1957) and later championed clean climbing, which spared Yosemite's cracks the scars that pitons were leaving."
legacy_year = 1957
idle_lines = PackedStringArray("Leave the rock the way you found it. The next party deserves the same climb you had.", "Style matters. How you get up is part of what you did.")
story_beats = [{"after": "harding_summit", "lines": ["You freed the Nose. Warren nailed it and you freed it. You both got to the top. Only one of you left the rock the way you found it.", "Don't tell him I said that. Actually, do."]}, {"after": "clark_last_page", "lines": ["Write the route down, and how you climbed it. The how is the part that's yours."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.353, 0.478, 0.627, 1)
home = "The Ahwahnee"
needs_tribal_review = false
sources = "Portrayal to confirm with the Robbins family, since he died recently. To verify: Royal Robbins, Basic Rockcraft (1971); Steve Roper, Camp 4 (1994)."
