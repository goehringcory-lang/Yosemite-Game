[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://scripts/story/character_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/sprites/npcs/dick_leonard.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "dick_leonard"
display_name = "Dick Leonard"
years = "1908–1993"
affiliation = "Sierra Club Rock Climbing Section"
bio = "Berkeley lawyer who started the Cragmont Climbing Club in 1932, which grew into the Sierra Club's Rock Climbing Section. He championed the dynamic belay, which catches a falling climber gently instead of stopping them short. In 1934 he, Jules Eichorn, and Bestor Robinson made the first ascent of Higher Cathedral Spire, one of the first technical rock climbs in Yosemite Valley."
legacy = "Started the climbing club that became the Sierra Club's Rock Climbing Section (1932) and championed the dynamic belay. He later served as the Sierra Club's president and spent his life on conservation."
legacy_year = 1932
idle_lines = PackedStringArray("Keep your weight over your feet. Granite rewards patience.", "Jules and Bestor are off scouting the Cathedral Spires again.")
story_beats = [{"after": "eichorn_apron", "lines": ["Jules says you led the Apron and didn't hurry. From Jules, that's a medal."]}, {"after": "eichorn_spires", "lines": ["You've been up the Spire? In '34 we thought that was the edge of the possible. We'd read Underhill's article on rope work and practiced falling off the Berkeley rocks before we dared try it."]}, {"after": "harding_summit", "lines": ["El Capitan, free. When we started, a climb like that wasn't even a dream. It would have read like a misprint."]}, {"after": "clark_last_page", "lines": ["Clark showed me your Register. There's a page in there about the belay, I see.", "That's all any of us did, really: held the rope for the next one. Now you hold it."]}]
sprite_sheet = ExtResource("2_sprite")
color = Color(0.35, 0.45, 0.6, 1)
sources = "To verify: Steve Roper, Camp 4: Recollections of a Yosemite Rockclimber (1994); Sierra Club Bulletin (1934); Sierra Club history pages; Robert Underhill, 'On the Use and Management of the Rope in Rock Work', Sierra Club Bulletin (1931), where the Section learned its rope work."
home = "Swan Slab, behind Camp 4"
