[ext_resource type="Texture2D" path="res://assets/sprites/npcs/wilderness_ranger.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "wilderness_ranger"
display_name = "Ranger Pruitt"
years = "1970s"
affiliation = "National Park Service, wilderness ranger"
bio = "A backcountry ranger who walks the Yosemite wilderness for weeks at a time, checking permits and camps. Turns up beside any camp that breaks Leave No Trace. An invented character, not a historical figure."
idle_lines = PackedStringArray("Leave it like nobody slept here.")
sprite_sheet = ExtResource("2_sprite")
color = Color(0.415, 0.47, 0.3, 1)
home = "The wilderness, wherever the trail goes"
sources = "Invented for the game. Yosemite's wilderness rules: camp at least 100 feet from water and trails, on durable ground, food stored in a bear-resistant canister, and fires only in existing rings (and none above 9,600 feet). The seven Leave No Trace principles come from the Leave No Trace Center for Outdoor Ethics."
