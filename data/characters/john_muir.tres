[ext_resource type="Texture2D" path="res://assets/sprites/npcs/john_muir.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "john_muir"
display_name = "John Muir"
years = "1838–1914"
affiliation = "Naturalist"
bio = "Came to Yosemite in 1868 and worked at James Hutchings's sawmill in the valley. In 1869 he climbed Cathedral Peak, and in the early 1870s he found living glaciers high in the Sierra. His writing helped create Yosemite National Park in 1890. His views of Native people were often dismissive, and the Register should say that too."
idle_lines = PackedStringArray("A crust of bread and a cup of tea, and you can go anywhere.", "The mountains are calling. Well, they're always calling. You just have to listen.")
rare_lines = PackedStringArray("Once, in a December gale on the Yuba, I climbed a tall Douglas spruce to see the storm from the inside.", "I rode its top like a bobolink on a reed. I never had a finer ride.")
rare_after_quest = "muir_glacier"
sprite_sheet = ExtResource("2_sprite")
color = Color(0.416, 0.353, 0.282, 1)
home = "Cathedral Lakes trailhead"
needs_tribal_review = false
sources = "To verify: John Muir, My First Summer in the Sierra (1911); Donald Worster, A Passion for Nature (2008). The windstorm lines paraphrase 'A Wind-Storm in the Forests' (1878; in The Mountains of California, 1894)."
