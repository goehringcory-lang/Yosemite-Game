[ext_resource type="Script" path="res://scripts/story/character_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/sprites/npcs/john_muir.png" id="2_sprite"]

[resource]
script = ExtResource("1_s")
id = "john_muir"
display_name = "John Muir"
years = "1838–1914"
affiliation = "Naturalist"
bio = "Came to Yosemite in 1868 and worked at James Hutchings's sawmill in the valley. In 1869 he climbed Cathedral Peak, and in the early 1870s he found living glaciers high in the Sierra. His writing helped create Yosemite National Park in 1890. His views of Native people were often dismissive, and the Register should say that too."
idle_lines = PackedStringArray("A crust of bread and a cup of tea, and you can go anywhere.", "The mountains are calling. Well, they're always calling. You just have to listen.")
story_beats = [{"after": "clark_last_page", "lines": ["Clark's book is finished? No book is ever finished. The mountains write in theirs every day: a new scratch on the granite, a new flower in the meadow.", "Come back next summer. There's always more to see."]}, {"after": "lost_guardian", "lines": ["So the guardian who gathers and never signs was you! I said I should like to meet that one. I've been meeting you all summer and never knew it.", "Don't sign it now, either. Let the mountains do the remembering."]}]
rare_lines = PackedStringArray("Once, in a December gale on the Yuba, I climbed a tall Douglas spruce to see the storm from the inside.", "I rode its top like a bobolink on a reed. I never had a finer ride.")
rare_after_quest = "muir_glacier"
sprite_sheet = ExtResource("2_sprite")
color = Color(0.416, 0.353, 0.282, 1)
home = "Cathedral Lakes trailhead"
needs_tribal_review = false
sources = "To verify: John Muir, My First Summer in the Sierra (1911); Donald Worster, A Passion for Nature (2008). The windstorm lines paraphrase 'A Wind-Storm in the Forests' (1878; in The Mountains of California, 1894). Cathedral Peak (September 1869) and 'the first time I have been at church in California' are from My First Summer; he spent that summer with Pat Delaney's sheep drive. 'Hoofed locusts' is his later phrase for sheep. The Maclure Glacier stakes (1872), his dispute with Josiah Whitney over how the Valley formed, and Whitney calling him a 'mere sheepherder' (as usually told) are to verify in Worster and Muir's 'Living Glaciers of California' (1872)."
