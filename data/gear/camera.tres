[resource]
script = ExtResource("1_gear")
id = "camera"
display_name = "Box Brownie"
description = "Ansel Adams's first camera, a Kodak Box Brownie from 1916, on loan. Press the camera key to raise it, move the frame over what you want, and press the shutter. Prints go in the album, with Ansel's list of pictures he'd like to see."
