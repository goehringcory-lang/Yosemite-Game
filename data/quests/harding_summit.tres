[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "harding_summit"
title = "The Nose"
main_line = true
giver = "warren_harding"
requires = PackedStringArray("robbins_roof", "tabuce_chuckah")
intro = PackedStringArray("The Nose. Three thousand feet of granite, straight up the prow of El Cap. In '58 we took forty-seven days over a year and a half to climb it, with pitons, a hundred and twenty-five bolts, and a lot of wine.", "And now you want to climb it free? No aid, no pulling on the gear, just you and the rock? Nobody's ever done that. Your book calls it 5.13. I call it crazy. I like it.", "People keep asking me about this missing Guardian. Way I see it, nobody owned El Cap till somebody climbed it, and nobody's the Guardian till somebody does the job. Somebody had better get on with it.", "You'll still eat a mountain of food doing it, and I'll equip you piece by piece. First, bake me four batches of acorn cakes. Tabuce can show you how.")
steps = [{"type": "made", "recipe": "acorn_cake", "count": 4, "gear": {"aiders": 2}, "objective": "Make acorn cakes 4 times", "reminder": "Acorn cakes. Four batches. Tabuce can show you how if you don't know.", "done": ["That's real wall food. It keeps for days and doesn't crumble in the haul bag.", "And here, two aiders. You're going free, but carry them anyway. Nobody frees every pitch on the first try, and there's no shame in standing in a sling to work out the moves."]}, {"type": "have_food", "energy": 150, "gear": {"haul_bag": 1}, "objective": "Carry food worth 150 energy", "reminder": "Pack it all. A big wall eats food like a furnace.", "done": ["Now we're talking. That'll feed a wall team for a week. Here's a bag to haul it in."]}, {"type": "stored", "count": 30, "objective": "Store 30 acorns in your chuckahs", "reminder": "Thirty acorns stored. Food you can count on all year. Tabuce will tell you the same.", "done": ["Thirty stored. That's a real reserve. Now you're ready to go up."]}, {"type": "have", "item": "acorn_cake", "count": 2, "objective": "Carry 2 acorn cakes", "reminder": "Two acorn cakes in your pack. They're the only thing that keeps on a long wall.", "done": ["Good. You're thinking like a wall climber."]}, {"type": "climbed", "route": "the_nose", "objective": "Tick the Nose of El Capitan, 5.13 free (two nights on the wall)", "reminder": "The Nose starts right at the toe of El Cap. The Great Roof and the Changing Corners are the hard parts. Bring a real meal for each night.", "done": ["You climbed it free? Every pitch, hands and feet, no pulling on gear? Three thousand feet!", "We needed a hundred and twenty-five bolts and forty-seven days. Put that in your book next to my name."]}]
outro = PackedStringArray("Our last night up there, I drilled bolts up the final overhang till dawn and staggered over the rim at sunrise. Somebody asked me later who'd conquered whom. Honestly, I couldn't say. El Cap looked in much better shape than I did.","The road to Tuolumne's open to you now. Go and find Muir up there. He won't stop talking about glaciers.")
reward_unlocks = PackedStringArray("hub:tuolumne_meadows")
