[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "harding_summit"
title = "The Nose"
main_line = true
giver = "warren_harding"
requires = PackedStringArray("salathe_steel", "tabuce_chuckah")
intro = PackedStringArray("The Nose. Three thousand feet of granite, straight up the prow of El Cap. We're going to climb it.", "We'll fix ropes and haul loads for days, and we'll eat a mountain of food doing it. I'll equip you piece by piece, but you have to earn each one.", "First, bake me four batches of acorn cakes. Tabuce can show you how.")
steps = [{"type": "made", "recipe": "acorn_cake", "count": 4, "gear": {"aiders": 2}, "objective": "Make acorn cakes 4 times", "reminder": "Acorn cakes. Four batches. Tabuce can show you how if you don't know.", "done": ["That's real wall food. It keeps for days and doesn't crumble in the haul bag.", "And here, two aiders. Your feet go in these on the blank sections."]}, {"type": "have_food", "energy": 150, "gear": {"haul_bag": 1}, "objective": "Carry food worth 150 energy", "reminder": "Pack it all. A big wall eats food like a furnace.", "done": ["Now we're talking. That'll feed a wall team for a week. Here's a bag to haul it in."]}, {"type": "stored", "count": 30, "objective": "Store 30 acorns in your chuckahs", "reminder": "Thirty acorns stored. Food you can count on all year. Beverly Johnson insists.", "done": ["Thirty stored. That's a real reserve. Bev wants a word with you."]}, {"type": "have", "item": "acorn_cake", "count": 2, "objective": "Carry 2 acorn cakes", "reminder": "Two acorn cakes in your pack. They're the only thing that keeps on a long wall.", "done": ["Good. You're thinking like a wall climber."]}, {"type": "talk", "target": "beverly_johnson", "gear": {"ascenders": 2, "portaledge": 1}, "objective": "See Beverly Johnson about sleeping on the wall", "reminder": "Beverly Johnson is at El Capitan Meadow, with the haul bags.", "done": ["When I soloed the Dihedral Wall I was up there ten days. Nobody to share the hauling, nobody to check my knots. You're only as good as your planning.", "Warren says you've planned well. Ascenders for the fixed lines, and a portaledge to sleep on. Count everything twice."]}, {"type": "climbed", "route": "the_nose", "objective": "Tick the Nose of El Capitan (two nights on the wall)", "reminder": "The Nose starts right at the toe of El Cap. Bring a real meal for each night.", "done": ["You topped out! Three thousand feet!"]}]
outro = PackedStringArray("Somebody said the Nose was the end of Yosemite climbing. It was only the beginning.", "The road to Tuolumne's open to you now. Go and find Muir up there. He won't stop talking about glaciers.")
reward_unlocks = PackedStringArray("hub:tuolumne_meadows")
