[resource]
script = ExtResource("1_s")
id = "tabuce_acorns"
title = "Acorns for the Winter"
giver = "maggie_howard"
requires = PackedStringArray()
intro = PackedStringArray("[Placeholder dialogue pending tribal review.]", "You want to climb out of the Valley? Then you'll need food that lasts.", "In the fall the black oaks drop their acorns. Gather twelve good ones and bring them to me.")
steps = [{"type": "have", "item": "black_oak_acorn", "count": 12, "consume": false, "objective": "Gather 12 black oak acorns (they drop in fall)", "reminder": "Look under the black oaks in the fall. Bring me twelve.", "done": ["These are good ones. Now they need a place to keep, up off the ground where the squirrels can't get them."]}]
outro = PackedStringArray("Build a chuckah near your camp. I'll show you how.")
reward_unlocks = PackedStringArray("chuckah")
