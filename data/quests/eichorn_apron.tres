[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "eichorn_apron"
title = "Up the Apron"
main_line = true
giver = "jules_eichorn"
requires = PackedStringArray("leonard_belay")
intro = PackedStringArray("Dick sent you? Good. I teach friction here at the foot of the Glacier Point Apron, right above Curry Village.", "Slab climbing is trust. Tiny edges, flat feet, hardly any hands. You've got the rope and the two cams Dick gave you, and that's all the Apron takes. Place a cam whenever you find a crack, and don't climb too far above your last one.", "Lead it, then come and tell me how it went. It tops out on the rim at Glacier Point.")
steps = [{"type": "climbed", "route": "glacier_point_apron", "objective": "Tick the Glacier Point Apron, 5.7 (the slab above Curry Village)", "reminder": "The Apron starts just up the trail from Curry Village. Lead it, with cams where the cracks are.", "done": ["Clean lead. You didn't hurry. Good."]}]
outro = PackedStringArray("A couple more cams and a few quickdraws from the Section's locker. That's the start of a real rack.", "Next page is a 5.8: Nutcracker, near El Capitan. Royal Robbins is up at the Ahwahnee. He climbed it first, and he'll want to tell you how to climb it. Go and listen, then come back to me for the Spire.")
reward_gear = {"cam": 2, "quickdraw": 2}
