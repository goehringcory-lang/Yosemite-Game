[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "lost_guardian"
title = "The Lost Guardian"
main_line = true
giver = "galen_clark"
requires = PackedStringArray("clark_last_page", "enid_full_press")
intro = PackedStringArray("So the press is full and the Register is written, and you want to know about that box under the Royal Arches.", "I'll tell you what I think. I don't think that Guardian was ever lost. I think nobody had got there yet.", "Go up behind the Ahwahnee, to the foot of the Royal Arches. There's a gap in the talus where the cold air comes out. Take the last sheet with you.")
steps = [{"type": "unlocked", "ability": "guardian_found", "objective": "Find the gap in the talus under the Royal Arches, behind the Ahwahnee, and go in", "reminder": "Under the Royal Arches, behind the Ahwahnee, where the big blocks lie against the cliff. You'll feel the cold air before you see the gap.", "done": ["You looked, then.", "I couldn't have told you. You'd have laughed at an old man, or worse, believed him before you'd done the walking."]}]
outro = PackedStringArray("Every plant in that press, every name in that book, every pitch on that list. Nobody told you to care about all of it. You just went on doing it.", "That's the whole of the job. It always was. Welcome, Guardian.")
reward_unlocks = PackedStringArray("guardian")
