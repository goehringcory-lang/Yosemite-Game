[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "clark_register"
title = "The Guidebook"
main_line = true
giver = "galen_clark"
requires = PackedStringArray()
intro = PackedStringArray("Good morning. You're the one camping at Lamon's place? Then you'll want this.", "In 1864, with the war still on, President Lincoln signed this valley and the Big Tree Grove over to California, to be held 'for public use, resort and recreation.' Two years later the State made me Guardian.", "This is my register. I've been writing down what happens here, as I see it. Now it's yours to fill: go and meet the people of this place, listen, and write down what they tell you, and who told you.", "But you can't learn a valley by standing in it. The walls are the point, and the people here know them by their routes. There's a book for that: a climbing guidebook, every route with its grade and the gear it takes.", "The Mountain Shop in Curry Village sells copies. It's a short walk south through the gate. Ask about one, and gather some food on the way: they trade in food, not money.", "One more thing. When you have time, walk up Tenaya Creek toward Mirror Lake. A man there says my pages leave something out. I would like to know what.")
steps = [{"type": "talk", "target": "mountain_shop", "objective": "Ask at the Mountain Shop in Curry Village about a climbing guidebook", "reminder": "Out the south gate to Curry Village. The Mountain Shop is the building by the store.", "done": ["Clark sent you? Then you'll want a guidebook. Every route in the Valley, every grade, every piece of gear it takes."]}]
outro = PackedStringArray()
reward_unlocks = PackedStringArray("register")
