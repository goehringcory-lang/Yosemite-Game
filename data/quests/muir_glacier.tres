[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "muir_glacier"
title = "Living Ice"
main_line = true
giver = "john_muir"
requires = PackedStringArray("muir_cathedral")
intro = PackedStringArray("Mount Lyell carries a glacier on its shoulder, and Maclure has another beside it. A living one, still moving and carving the rock.", "I drove a row of stakes straight across the Maclure ice and came back weeks later. They'd marched downhill, near an inch a day, the middle ones farthest. Ice doesn't lie, whatever the professors say.", "Go up with your axe and crampons. Look at the crevasses, and the polished granite below the ice. That's the tool that carved this whole valley.")
steps = [{"type": "climbed", "route": "lyell_glacier", "objective": "Tick the Lyell Glacier (up Lyell Canyon)", "reminder": "The Lyell Canyon trail starts by the Tuolumne lodge. You'll need the axe and crampons.", "done": ["You walked on the glacier! Crevasses, moraines, polished rock. Glaciers made this valley. I'm sure of it."]}]
outro = PackedStringArray("I've written a great deal about these mountains. Put this down too: I didn't always see the people who lived here, and they saw a great deal I missed.", "Now take that book of yours back down to Galen Clark. He'll want to hear about the ice, and about everyone you've met.")
reward_items = {"pine_nuts": 4}
reward_unlocks = PackedStringArray("register_glaciers")
