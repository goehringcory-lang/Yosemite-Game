[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "harding_nose"
title = "Siege Supplies"
giver = "warren_harding"
requires = PackedStringArray("salathe_steel")
intro = PackedStringArray("The Nose. Three thousand feet of granite, straight up the prow of El Cap. We're going to climb it.", "We'll fix ropes and haul loads for days, and we'll eat a mountain of food doing it.", "Bake me four batches of acorn cakes and pack plenty of trail food. Then I'll hand over the big-wall kit.")
steps = [{"type": "made", "recipe": "acorn_cake", "count": 4, "objective": "Make acorn cakes 4 times", "reminder": "Acorn cakes. Four batches. Tabuce can show you how if you don't know.", "done": ["That's real wall food. Keeps for days and doesn't crumble in the haul bag."]}, {"type": "have_food", "energy": 150, "objective": "Carry food worth 150 energy", "reminder": "Pack it all. A big wall eats food like a furnace.", "done": ["Now we're talking. That'll feed a wall team for a week."]}]
outro = PackedStringArray("Aiders for the blank sections and a haul bag for all that food.", "Now go find Beverly Johnson. You'll want ascenders and a portaledge before you're up there overnight.")
reward_gear = {"aiders": 2, "haul_bag": 1}
