[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "tabuce_chuckah"
title = "The Chuckah"
giver = "maggie_howard"
requires = PackedStringArray("tabuce_acorns")
intro = PackedStringArray("[Placeholder dialogue pending tribal review.]", "A chuckah keeps acorns dry and safe all winter. Build one at your camp, then fill it.")
steps = [{"type": "chuckah", "count": 1, "objective": "Build a chuckah at your camp", "reminder": "Build the chuckah at your camp, where you can watch it.", "done": ["That will hold them."]}, {"type": "stored", "count": 12, "objective": "Store 12 acorns in your chuckah", "reminder": "Put your acorns in the chuckah. They'll keep there all year.", "done": ["Now you'll have acorns whenever you need them."]}]
outro = PackedStringArray("When you want food, take some acorns out. Crack them, then pound them into flour at the grinding rocks.", "Rinse the flour with water, again and again, until the bitterness is gone. Then cook it with hot stones.", "Mush fills you up, but eat it soon. Cakes last for days.")
reward_recipes = PackedStringArray("acorn_flour", "leached_acorn_meal", "acorn_mush", "acorn_cake")
