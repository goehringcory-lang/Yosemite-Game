[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "partner_apron"
title = "Looking for a Partner"
main_line = true
giver = "wren_alvarez"
requires = PackedStringArray("shop_outfit")
intro = PackedStringArray("Marty sent you? Oh, thank goodness. I've been flaking this rope for an hour pretending I wasn't waiting for anybody.", "I'm Wren. I started at the shop on Monday. Back home I climbed every weekend, but I don't know anyone here yet, and you can't climb a slab alone.", "This is Firefall Slab: two pitches of friction straight up the Apron, bolted the whole way. You lead, I'll belay, and my rope reaches both pitches. Clip every bolt with a quickdraw, keep your heels low, and chalk up before the steep bit.", "Pack something to eat first. We'll be up there a while.")
steps = [{"type": "have_food", "energy": 25, "objective": "Carry food worth 25 energy for the climb", "reminder": "Grab something to eat first. The store across the green trades trail food for forage.", "done": ["Perfect. Tie in, and I'll put you on belay."]}, {"type": "climbed", "route": "firefall_slab", "objective": "Lead Firefall Slab with Wren on belay, and tick it in your guidebook", "reminder": "The start's right here by the trail post. Shoes, chalk bag, harness, five draws. I've got the rope.", "done": ["You cruised that! I could hear you laughing on the second pitch.", "Your first tick in the Valley, and my first partner. 5.5, done. Every route in that book is a step up from here."]}]
outro = PackedStringArray("Bolts are the friendly way in. Most walls here don't have them, and you place your own protection as you go.", "The Sierra Club folks run practice days at Swan Slab, behind Camp 4. Ask for Dick Leonard and tell him Wren sent you. Then come back and we'll do the rest of the Apron.")
reward_items = {"trail_mix": 1}
