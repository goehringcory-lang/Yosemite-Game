[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "mccauley_firefall"
title = "The Fall of Fire"
giver = "james_mccauley"
requires = PackedStringArray("eichorn_apron")
intro = PackedStringArray("Climbed up the Apron, did you? Most people take my trail. There's a toll, but your fingers thank you.", "Every summer evening we push the embers of a big fir-bark fire off the edge, and they fall like a waterfall of light.", "Everybody's asking after the Guardian. I'd push the Firefall off twice a night if I thought they'd see it and come home.", "Folks at Camp Curry shout up for it. Go ask Mrs. Curry what she thinks of my fire, then come tell me.")
steps = [{"type": "talk", "target": "jennie_curry", "objective": "Ask Jennie Curry about the Firefall", "reminder": "Camp Curry's straight below us. Take the Four Mile Trail down.", "done": ["The Firefall? David called for it every night: 'Let the fire fall!' The guests love it.", "Some say it's the finest sight in the park. Some say it's a circus trick in a place that doesn't need one. You'll have to decide for yourself."]}, {"type": "return", "objective": "Go back to James McCauley at Glacier Point", "reminder": "Come back up and tell me what she said.", "done": ["A circus trick! Well. Maybe it is. People still come to see it."]}]
outro = PackedStringArray("Write down that it's beautiful, and write down that it's a bonfire shoved off a cliff. Both are true.", "Take some bread for the walk. It comes up from Degnan's on the mule.")
reward_items = {"degnan_loaf": 2}
reward_unlocks = PackedStringArray("register_firefall")
