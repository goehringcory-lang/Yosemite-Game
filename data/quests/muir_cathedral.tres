[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "muir_cathedral"
title = "Cathedral Peak"
main_line = true
giver = "john_muir"
requires = PackedStringArray("harding_summit")
intro = PackedStringArray("You came up the long road from the Valley? Then you've earned this air. Breathe it! It does a body more good than any physic.", "I came up here my first summer minding Mr. Delaney's sheep. Hoofed locusts, the lot of them, but they brought me to the high country, and I'll thank them for that much.", "Cathedral Peak! I went up it in September of '69 with a notebook tied to my belt and a crust of bread in my pocket. On top I wrote that it was the first time I had been at church in California.", "Climb it and see. Carry some food, mind. I've gone up on bread and tea more often than was sensible, and I don't recommend it to anybody else.")
steps = [{"type": "have_food", "energy": 40, "objective": "Carry food worth 40 energy", "reminder": "Bread and tea will do. Don't go up hungry.", "done": ["Bread! Good. Now go up."]}, {"type": "climbed", "route": "cathedral_peak", "objective": "Tick Cathedral Peak (the trail starts here at Tuolumne)", "reminder": "The trail to Cathedral Peak starts right here.", "done": ["You were on top! Did you feel the whole range around you?"]}]
outro = PackedStringArray("Now the glaciers. Professor Whitney says the Valley floor simply sank, and that the Sierra's ice is long dead. He calls me a mere sheepherder. Well, I was one.", "But I've found living ice up high, on the shoulders of Lyell and Maclure. Take an ice axe and crampons, and go and see it for yourself.")
reward_gear = {"ice_axe": 1, "crampons": 1}
