[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "leonard_belay"
title = "The Rock Climbing Section"
main_line = true
giver = "dick_leonard"
requires = PackedStringArray("partner_apron")
intro = PackedStringArray("Wren sent you? Good. You can follow bolts up a slab, then. Most walls here don't have any: you protect them yourself, and your partner's life is in your hands at the belay.", "I climb with the Sierra Club's Rock Climbing Section. Most of us learned our ropework out of a magazine article, if you can believe it. Everything depends on the belay: let the rope run a little when your partner falls, and you'll catch them gently instead of yanking them tight.", "Let's start at the beginning anyway. Bring some trail food, because nobody climbs well hungry. Then try Swan Slab, right up here. I'll belay you from the top and you watch how I handle the rope.")
steps = [{"type": "have_food", "energy": 30, "objective": "Carry trail food worth 30 energy", "reminder": "Nobody climbs well hungry. Bring some food: greens, berries, whatever's in season.", "done": ["That'll keep you going for a long day. Up you go."]}, {"type": "climbed", "route": "swan_slab", "objective": "Tick Swan Slab, 5.6, in your guidebook (the practice slab behind Camp 4)", "reminder": "Swan Slab's just up from Camp 4. I'll have the rope ready. It's a top rope, so you don't need gear.", "done": ["Nicely done. You trust your feet, and that's the whole game on slab.", "The Sierra Club sorts climbs into classes, one to six. Class 1 is a walk. Class 5 is where you need a rope and protection. That gully was an easy 5: a 5.6, the way your book writes it."]}]
outro = PackedStringArray("You're ready for something bigger. Take this kit: a rope of your own and a couple of cams. Your harness will do fine.", "Turn the page: the Glacier Point Apron, above Curry Village. Jules Eichorn is teaching friction at the foot of it. Go and see him.")
reward_gear = {"rope": 1, "cam": 2}
