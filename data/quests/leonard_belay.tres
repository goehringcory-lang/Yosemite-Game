[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "leonard_belay"
title = "The Rock Climbing Section"
main_line = true
giver = "dick_leonard"
requires = PackedStringArray("clark_register")
intro = PackedStringArray("You've got the guidebook? Good. Page one is mine.", "I climb with the Sierra Club's Rock Climbing Section. Most of us learned our ropework out of a magazine article, if you can believe it. Everything depends on the belay: let the rope run a little when your partner falls, and you'll catch them gently instead of yanking them tight.", "Let's see how you move. Bring some trail food first, because nobody climbs well hungry. Then try Swan Slab, right up here. I'll belay you from the top.")
steps = [{"type": "have_food", "energy": 30, "objective": "Carry trail food worth 30 energy", "reminder": "Nobody climbs well hungry. Bring some food: greens, berries, whatever's in season.", "done": ["That'll keep you going for a long day. Up you go."]}, {"type": "climbed", "route": "swan_slab", "objective": "Tick Swan Slab in your guidebook (the practice slab behind Camp 4)", "reminder": "Swan Slab's just up from Camp 4. I'll have the rope ready. It's a top rope, so you don't need gear.", "done": ["Nicely done. You trust your feet, and that's the whole game on slab."]}]
outro = PackedStringArray("You're ready for something bigger. Take this kit: a rope, a harness, and a couple of cams.", "Turn the page: the Glacier Point Apron, above Curry Village. Jules Eichorn is teaching friction at the foot of it. Go and see him.")
reward_gear = {"rope": 1, "harness": 1, "cam": 2}
