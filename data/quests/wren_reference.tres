[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "wren_reference"
title = "With a Form"
giver = "wren_alvarez"
requires = PackedStringArray("wren_apron", "robbins_clean", "hodges_rescue_team")
intro = PackedStringArray("Okay. Don't laugh. I'm applying to guide for the climbing school next season. Like, actually applying. With a form.", "It wants two references. Marty said yes before I finished asking, which worries me. The other one has to be somebody who's seen climbers make decisions, which means Jo Tolliver, which means I can't breathe.", "Would you take it round for me? If I go myself I'll just say sorry a lot and leave. You can stand there looking like a satisfied customer.")
steps = [{"type": "talk", "target": "mountain_shop", "objective": "Take Wren's application to Marty Kessler at the Mountain Shop for her first reference", "reminder": "Marty first. He's the easy one. He's also behind the counter, so you can't miss him.", "done": ["Her reference? Let me see the form. ...She's spelled 'belay' three different ways.", "Here's what I'll write. Every rope that comes back from her, I check twice, same as anybody's. I've never once found a thing wrong with how she treats her gear. Or her partners.", "Don't tell her I said partners. She'll cry in the rental shoes again.", "Signed. Go and see Jo. Jo's the hard one."]}, {"type": "talk", "target": "jo_tolliver", "objective": "Ask Jo Tolliver at the search and rescue site for Wren's second reference", "reminder": "Jo's at the rescue site in Camp 4. If she asks you anything, just say what I'd say, but more calmly.", "done": ["Wren Alvarez wants to take strangers up rock for money. Hm.", "Everybody in this valley is a good climber. I don't sign for good climbers. I sign for the ones who know when to turn round, because they're the ones I never have to go and get.", "Ask her when she'd turn a client round. Not what the book says. What she'd actually do. Then come back."]}, {"type": "talk", "target": "wren_alvarez", "objective": "Ask Wren when she'd turn a client around, for Jo", "reminder": "Jo asked you something about me? Then ask me. I'm right here, panicking.", "done": ["She asked WHAT? ...Okay. Okay. When would I turn round.", "When the sky goes that grey-green color over the Cathedrals. When they stop laughing at my jokes, because that means they're scared. When I'm scared and pretending I'm not.", "That last one's the big one. Is that a stupid answer? Don't tell me. Just take it to her."]}, {"type": "talk", "target": "jo_tolliver", "objective": "Take Wren's answer back to Jo Tolliver at the search and rescue site", "reminder": "Did you take it to Jo yet? Don't tell me what her face did. Okay, tell me.", "done": ["'When I'm scared and pretending I'm not.' She said that?", "All the seasons I've been hauling people off these walls, and that's the whole job in one sentence.", "Signed. Tell her the school would be lucky. Tell her I said lucky, I don't say it."]}, {"type": "pay", "energy": 20, "objective": "Bring Wren a lunch for her check-out climb (food worth 20 energy)", "reminder": "Check-out climb's this afternoon. I can't eat. I'll be able to eat after. Probably. Bring me something I'll want when I'm hungry again.", "done": ["You're the best. I'll eat it on the ledge if my hands stop shaking.", "...", "Okay, it's done! The head guide watched me lead Firefall Slab, set up a top rope and do a rescue lower with a sandbag named Gerald.", "They don't tell you if you got it. They post the list in spring, when the snow's off the Apron. So now I just wait. Forever."]}]
outro = PackedStringArray("Both references, signed. Marty said I'm careful with partners. Jo said lucky. Jo doesn't say lucky.", "I owe you. Here, these were supposed to be my nerves snacks, but my nerves are gone.")
reward_items = {"trail_mix": 2}
