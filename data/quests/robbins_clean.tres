[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "robbins_clean"
title = "Clean Climbing"
main_line = true
giver = "royal_robbins"
requires = PackedStringArray("eichorn_spires")
intro = PackedStringArray("Eichorn sent you? Good. I like climbers who learned on the Section's routes. But I care how you climb it, not only whether you do.", "Every bolt and piton leaves a mark, and the next party climbs the rock we leave behind. The Royal Arches start right behind this hotel: sixteen pitches, and almost all of it you can protect with gear you take out again.", "Climb them clean.")
steps = [{"type": "climbed", "route": "royal_arches", "objective": "Tick the Royal Arches, leaving no trace (behind the Ahwahnee)", "reminder": "The Royal Arches start behind the hotel. Clean climbing only: leave nothing behind.", "done": ["Sixteen pitches and you left nothing behind? That's style."]}]
outro = PackedStringArray("A belay and rappel device, two more cams, and two more quickdraws. You're ready for Snake Dike on Half Dome.", "It's thin up there, with long runouts. Place your protection well. John Salathé at Camp 4 will want to hear about it.")
reward_gear = {"belay_device": 1, "cam": 2, "quickdraw": 2}
