[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "robbins_clean"
title = "Clean Climbing"
main_line = true
giver = "royal_robbins"
requires = PackedStringArray("eichorn_apron")
intro = PackedStringArray("Eichorn sent you? Good. I like climbers who learned on the Section's routes. But I care how you climb a route, not only whether you do.", "Those numbers in your guidebook? Some of us worked out the decimals at Tahquitz Rock, down south, years ago. Class 5 wasn't enough: 5.0 up to 5.9, and then people kept climbing harder, so now there's 5.10 and beyond.", "Every bolt and piton leaves a mark, and the next party climbs the rock we leave behind. Liz and I climbed Nutcracker with nothing but nuts: you place them, and the second takes them out again. Five pitches, 5.8, on the Manure Pile Buttress across from El Cap.", "The Guardian, wherever they've got to, always climbed like that. You could follow them up a crack and never know they'd been there. Maybe that's why nobody can find them.", "Climb it clean.")
steps = [{"type": "climbed", "route": "nutcracker", "objective": "Tick Nutcracker, 5.8, leaving no trace (Manure Pile Buttress, near El Capitan)", "reminder": "Nutcracker's on the Manure Pile Buttress, west of Camp 4 on the north side. Clean climbing only: leave nothing behind.", "done": ["The mantel at the top? Everybody remembers that move. And you left nothing behind. That's style."]}]
outro = PackedStringArray("A belay and rappel device, two more cams, and two more quickdraws. Your rack is ready for 5.9.", "Jules Eichorn wants you on Higher Cathedral Spire next. Climb it the way the Section did in '34, but leave less behind than they did.")
reward_gear = {"belay_device": 1, "cam": 2, "quickdraw": 2}
