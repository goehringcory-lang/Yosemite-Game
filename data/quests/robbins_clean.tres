[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "robbins_clean"
title = "Clean Climbing"
giver = "royal_robbins"
requires = PackedStringArray("eichorn_spires", "anderson_half_dome")
intro = PackedStringArray("Is that one of George Anderson's eyebolts? Amazing. Bold, what he did. The holes are still up there.", "That's what I want you to think about. Every bolt and piton leaves a mark, and the next party climbs the rock we leave behind.", "Climb the Royal Arches using only what you can take out again. Then come back and we'll talk about Half Dome.")
steps = [{"type": "have", "item": "anderson_eyebolt", "count": 1, "objective": "Show Royal Robbins Anderson's eyebolt", "reminder": "Did Anderson give you something from the Dome? I'd like to see it.", "done": ["Hand-forged. You can see the hammer marks. Keep it. It belongs in your Register, not a drawer."]}, {"type": "climbed", "route": "royal_arches", "objective": "Climb the Royal Arches, leaving no trace", "reminder": "The Royal Arches start behind the Ahwahnee. Clean climbing only.", "done": ["Sixteen pitches and you left nothing behind? That's style."]}]
outro = PackedStringArray("A belay and rappel device, two more cams, and two more quickdraws. You're ready for Snake Dike on Half Dome.", "It's thin up there, with long runouts. Place your protection well.")
reward_gear = {"belay_device": 1, "cam": 2, "quickdraw": 2}
