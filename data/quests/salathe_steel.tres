[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "salathe_steel"
title = "Hard Steel"
main_line = true
giver = "john_salathe"
requires = PackedStringArray("robbins_clean")
intro = PackedStringArray("Soft iron pitons bend in these cracks like wet noodles. I forge mine from old car axles. Model A Ford steel is the best there is.", "Find me an axle. There's an old wreck down by the railroad yard at El Portal, I'm told. Then climb Snake Dike, so I know you're serious.")
steps = [{"type": "have", "item": "model_a_axle", "count": 1, "consume": true, "objective": "Bring John Salathé a Model A axle from the El Portal railyard", "reminder": "The railroad yard at El Portal. Look for the rusted old Ford.", "done": ["Ah, that's the stuff. Listen to it ring.", "It needs a few days at the forge. Go and climb Snake Dike while it cools, and show me your hands when you're down."]}, {"type": "climbed", "route": "snake_dike", "objective": "Tick Snake Dike (up the back of Half Dome, from Happy Isles)", "reminder": "Snake Dike. Up the back of Half Dome. Go.", "done": ["Up Half Dome! Good. Now, my steel."]}]
outro = PackedStringArray("I've forged this into protection that won't bend. Two more pieces, and they'll hold on El Capitan.", "Go and see Warren Harding. He's been staring at the Nose for a year.")
reward_gear = {"cam": 2}
