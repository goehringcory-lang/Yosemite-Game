[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "salathe_steel"
title = "Hard Steel"
main_line = true
giver = "john_salathe"
requires = PackedStringArray("eichorn_spires")
intro = PackedStringArray("Soft iron pitons bend in these cracks like wet noodles. I forge mine from old car axles. Model A Ford steel is the best there is.", "Find me an axle. There's an old wreck down by the railroad yard at El Portal, I'm told.", "Then climb my route on Sentinel Rock. Allen Steck and I spent five days in those chimneys in 1950, with a few cups of water a day. Your book says 5.10b. I say it is hard, and it is long, and you breathe out to get through the Narrows.")
steps = [{"type": "have", "item": "model_a_axle", "count": 1, "consume": true, "objective": "Bring John Salathé a Model A axle from the El Portal railyard", "reminder": "The railroad yard at El Portal. Look for the rusted old Ford.", "done": ["Ah, that's the stuff. Listen to it ring.", "It needs a few days at the forge. Go and climb Sentinel while it cools, and show me your hands when you're down."]}, {"type": "climbed", "route": "steck_salathe", "objective": "Tick the Steck-Salathé, 5.10b (Sentinel Rock, up the Four Mile Trail)", "reminder": "Sentinel Rock, above the Four Mile Trail. Chimneys all day. Exhale for the Narrows.", "done": ["Look at those elbows! You've been in the Narrows, all right. Now, my steel."]}]
outro = PackedStringArray("I've forged this into protection that won't bend. Two more pieces, and they'll hold on the steep walls.", "The young ones climb harder than we did now, with nothing but their hands and feet. Beverly Johnson is out at El Capitan Meadow. She'll show you what 5.11 feels like.")
reward_gear = {"cam": 2}
