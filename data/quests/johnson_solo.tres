[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "johnson_solo"
title = "Self-Reliance"
giver = "beverly_johnson"
requires = PackedStringArray("robbins_clean")
intro = PackedStringArray("When I soloed the Dihedral Wall I was up there ten days, all alone. Nobody to share the hauling, nobody to check my knots.", "Up there, you're only as good as your planning. How much food have you put away?", "Get thirty acorns into a chuckah, and carry a couple of acorn cakes. Then we'll talk about sleeping on the wall.")
steps = [{"type": "stored", "count": 30, "objective": "Store 30 acorns in your chuckahs", "reminder": "Thirty acorns stored. Food you can count on all year.", "done": ["Thirty stored. That's a real reserve."]}, {"type": "have", "item": "acorn_cake", "count": 2, "objective": "Carry 2 acorn cakes", "reminder": "Two acorn cakes in your pack. They're the only thing that keeps on a long wall.", "done": ["Good. You're thinking like a wall climber."]}]
outro = PackedStringArray("Ascenders to climb your fixed ropes, and a portaledge to sleep on. You'll be fine up there as long as you count everything twice.")
reward_gear = {"ascenders": 2, "portaledge": 1}
