[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "lamon_orchard"
title = "Lamon's Garden"
giver = "james_lamon"
requires = PackedStringArray("clark_register")
intro = PackedStringArray("I've got apples in the cellar from last fall, more than I can eat.", "What I want is something green. Bring me a few Sierra onions from the meadow and some wild strawberries, and you can have a sack of apples.", "Apples keep. Good for a long day on the trail.")
steps = [{"type": "have", "item": "sierra_onion", "count": 2, "consume": true, "objective": "Bring James Lamon 2 Sierra onions", "reminder": "Onions grow in the wet meadows in spring. Look for the purple flowers.", "done": ["That's the stuff. Onion and fried potato for supper tonight."]}, {"type": "have", "item": "wild_strawberry", "count": 3, "consume": true, "objective": "Bring James Lamon 3 wild strawberries", "reminder": "Strawberries hide low in the meadow grass. Watch where you step.", "done": ["Sweet as anything. Now, those apples."]}]
outro = PackedStringArray("Here. They'll keep for a week or two in your pack, and they won't bruise if you're gentle.")
reward_items = {"lamon_apple": 4}
