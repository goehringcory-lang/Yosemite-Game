[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "wren_long_way"
title = "Swinging Leads"
giver = "wren_alvarez"
requires = PackedStringArray("wren_first_client", "bestor_arches", "jo_first_call")
intro = PackedStringArray("The school asked if I'm guiding again this summer. I haven't said yes. I haven't said anything. I've been re-soling shoes for a week so I don't have to.", "Can I ask you something? You've been out on a call with Jo. Ask her for me: has she ever had to go and get somebody who turned round?", "And then... I want to climb something with you. Something long. No clients, no form. Just to remember why I like this.")
steps = [{"type": "talk", "target": "jo_tolliver", "objective": "Ask Jo Tolliver, for Wren, if she's ever had to rescue someone who turned around", "reminder": "Just ask her. I'd do it, but I'd say sorry four times first.", "done": ["Somebody who turned round? Never. Not once, not in all my seasons here.", "The ones who turn round walk home. I go and get the ones who didn't.", "That client of hers wrote to the school. I know, because I wrote to them as well. Two pages. The school's keeping her.", "Tell her I said it twice: she walked him home. That's the job."]}, {"type": "have_food", "energy": 40, "objective": "Pack food for a long day on Royal Arches (40 energy) and show Wren", "reminder": "Royal Arches is sixteen pitches and then a long walk down North Dome Gully. Pack like we're not coming back for lunch, because we're not.", "done": ["Jo said that? Twice? ...Give me a second.", "Okay. Okay! Long day. You've got the food, I've got the rope. Dawn. If it's dawn now, we go now."]}, {"type": "time", "from": 5, "to": 8, "objective": "Meet Wren at dawn (5 to 8 AM) for Royal Arches, swinging leads", "reminder": "Dawn. Early, so we're off the Arches before the sun is.", "done": ["Here's the deal. Your lead, then mine, then yours, all the way up. Nobody's the client today. Nobody's the guide.", "You take the pendulum, since you've done it. I want the last pitches. I want to be the one who walks us onto the top.", "...", "That's it. That's the rim. Look at the Valley from here. Look how small the shop is.", "I'd forgotten. Not how to climb. What it's for.", "I'm saying yes to the school. I'm going to tell every client about the day I turned somebody round, and the day you and I swung leads up the Arches, and they're going to know it's the same thing."]}]
outro = PackedStringArray("The school gives its guides gear at cost, which means I can finally afford my own rack, which means you get one of my cams. It's a good one. I checked it twice. Marty checked it four times.", "And this is for your camp: my old chalk bag, on a peg next to a spot for yours. That's where it lives now, since I'm over there most Sundays anyway.", "First client, first partner. Same person. Not bad for a girl who almost quit in her first week.")
reward_gear = {"cam": 1}
