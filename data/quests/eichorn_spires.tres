[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "eichorn_spires"
title = "The Cathedral Spires"
main_line = true
giver = "jules_eichorn"
requires = PackedStringArray("eichorn_apron")
intro = PackedStringArray("Remember I said Dick, Bestor, and I climbed Higher Cathedral Spire in 1934? Everyone said it couldn't be done.", "You've got the rack for it now. Go and hear Bestor's side of the story first. He's here by the Apron trail with his notebook, and he tells it better than me, and longer. Then go and climb it.")
steps = [{"type": "talk", "target": "bestor_robinson", "objective": "Hear Bestor Robinson's side of the Spire story", "reminder": "Bestor's here by the foot of the Apron, probably with a notebook.", "done": ["The Spire? We got our pitons from a mail-order house in Munich, and we used thirty-eight of them. Nine hours. Jules tells it like it was easy. It wasn't.", "The Bathtub pitch is the one that gets people. Tell him the rope was my idea."]}, {"type": "climbed", "route": "higher_cathedral_spire", "objective": "Tick Higher Cathedral Spire (the south wall near Bridalveil)", "reminder": "The Spire's on the south wall of the Valley, near Bridalveil. Four cams and two quickdraws, and take your time.", "done": ["You stood where we stood in '34. His idea, the rope? Ha. Well, maybe it was."]}]
outro = PackedStringArray("Two more quickdraws, and that fills your rack for the Arches.", "Royal Robbins is up at the Ahwahnee, and he has opinions about how you climb. Go and listen.")
reward_gear = {"quickdraw": 2}
