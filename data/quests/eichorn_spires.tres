[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "eichorn_spires"
title = "The Cathedral Spires"
main_line = true
giver = "jules_eichorn"
requires = PackedStringArray("robbins_clean")
intro = PackedStringArray("Royal taught you to climb clean? Good. In 1934 Dick, Bestor, and I hammered thirty-odd pitons into Higher Cathedral Spire, and everyone said it couldn't be done at all.", "It's 5.9 now, climbed free. In our day we didn't have a number for it. Go and hear Bestor's side of the story first. He's here by the Apron trail with his notebook, and he tells it better than me, and longer. Then go and climb it.")
steps = [{"type": "talk", "target": "bestor_robinson", "objective": "Hear Bestor Robinson's side of the Spire story", "reminder": "Bestor's here by the foot of the Apron, probably with a notebook.", "done": ["The Spire? We got our pitons from a mail-order house in Munich, and we used thirty-eight of them. Nine hours. Jules tells it like it was easy. It wasn't.", "The Bathtub pitch is the one that gets people. Tell him the rope was my idea."]}, {"type": "climbed", "route": "higher_cathedral_spire", "objective": "Tick Higher Cathedral Spire, 5.9 (the south wall near Bridalveil)", "reminder": "The Spire's on the south wall of the Valley, near Bridalveil. Six cams, four quickdraws, and your belay device. Take your time.", "done": ["You stood where we stood in '34. His idea, the rope? Ha. Well, maybe it was."]}]
outro = PackedStringArray("Two more quickdraws. That's a rack for the big chimneys.", "Past 5.9 the numbers get serious. John Salathé at Camp 4 put up a 5.10 on Sentinel Rock in 1950, and he's been waiting for somebody worth sending up it. Go and see him.")
reward_gear = {"quickdraw": 2}
