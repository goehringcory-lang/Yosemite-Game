[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "clark_last_page"
title = "The Last Page"
main_line = true
giver = "galen_clark"
requires = PackedStringArray("lebrado_villages", "muir_glacier", "lucy_basket")
waiting_on = {"tenaya_ahwahnee": "Before we call this book nearly full: did you ever walk up Tenaya Creek? The man there told me my pages leave something out. Go and hear him, if he'll talk to you.", "lebrado_villages": "There's a woman in the meadow by the Ahwahnee, Tenaya's granddaughter. She remembers this valley from before my pages start. If she's willing to talk, I'd like to hear it.", "lucy_basket": "Lucy Telles weaves at the Museum every day, and her name isn't anywhere in this book. That's my doing, not hers. Go and see her."}
intro = PackedStringArray("You've been up the Lyell ice and back. Sit a minute. Let me look at this book.", "It started as mine. Now it's full of other people's handwriting, and they don't all agree. Some of it argues with my own pages, and it's right to.", "I came up into these mountains in '56 expecting to die. My lungs were bad, and the doctors didn't give me long. I've had a good many years since, and I spent them thinking I was the one looking after this place.", "Before you write the last page, go see Tabuce and Maria Lebrado. Ask them if there's anything they want written down, or if they'd rather keep it.")
steps = [{"type": "talk", "target": "maggie_howard", "objective": "Ask Tabuce if she wants anything written in the Register", "reminder": "Tabuce is by the oaks where she gathers acorns.", "done": ["[Placeholder dialogue pending tribal review.]", "Some things I'll tell you. Some things stay with my family. Leave that page blank."]}, {"type": "talk", "target": "maria_lebrado", "objective": "Ask Maria Lebrado if she wants anything written in the Register", "reminder": "Maria Lebrado is in the meadow by the Ahwahnee.", "done": ["[Placeholder dialogue pending tribal review.]", "I've said what I came to say. The rest belongs to my people."]}, {"type": "return", "objective": "Bring the Register back to Galen Clark", "reminder": "Bring the book back to me.", "done": ["Blank pages. Good. Those were never ours to fill."]}]
outro = PackedStringArray("I was called the Guardian, but nobody ever guarded this valley alone. Plenty of people were caring for it long before me.", "The last page is yours. Write what you like. Then keep going. The season's turning.")
reward_unlocks = PackedStringArray("ending")
