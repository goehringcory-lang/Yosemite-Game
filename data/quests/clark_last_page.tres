[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "clark_last_page"
title = "The Last Page"
giver = "galen_clark"
requires = PackedStringArray("lebrado_villages", "muir_glacier", "lucy_basket")
intro = PackedStringArray("Look at this book. It started as mine. Now it's full of other people's handwriting, and they don't all agree.", "Before you write the last page, go see Tabuce and Maria Lebrado. Ask them if there's anything they want written down, or if they'd rather keep it.")
steps = [{"type": "talk", "target": "maggie_howard", "objective": "Ask Tabuce if she wants anything written in the Register", "reminder": "Tabuce is by the oaks where she gathers acorns.", "done": ["[Placeholder dialogue pending tribal review.]", "Some things I'll tell you. Some things stay with my family. Leave that page blank."]}, {"type": "talk", "target": "maria_lebrado", "objective": "Ask Maria Lebrado if she wants anything written in the Register", "reminder": "Maria Lebrado is at Cook's Meadow.", "done": ["[Placeholder dialogue pending tribal review.]", "I've said what I came to say. The rest belongs to my people."]}, {"type": "return", "objective": "Bring the Register back to Galen Clark", "reminder": "Bring the book back to me.", "done": ["Blank pages. Good. Those were never ours to fill."]}]
outro = PackedStringArray("I was called the Guardian, but nobody ever guarded this valley alone. Plenty of people were caring for it long before me.", "The last page is yours. Write what you like. Then keep going. The season's turning.")
reward_unlocks = PackedStringArray("ending")
