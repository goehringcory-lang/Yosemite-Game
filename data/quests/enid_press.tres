[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "enid_press"
title = "The Plant Press"
press_line = true
giver = "enid_michael"
requires = PackedStringArray("clark_register")
intro = PackedStringArray("You're the one Mr. Clark gave the Register to. He's sent you to listen to people. I'd like you to listen to the plants as well.", "I keep the wildflower garden behind the Museum, so a visitor can learn a flower's name before they step on it. And I keep a press.", "This one isn't mine. It turned up in the Museum attic with a stack of mounted sheets. Every label is printed the same: 'Collected for the Guardian of Yosemite.' And every sheet is bare.", "Mr. Clark says they aren't his. So you take it. Collecting in the park takes a permit, and you'll work under mine: one sprig, never the whole plant, and some you only draw.", "Start close to home. Press three different plants from the Valley floor and bring the book back to me.")
start_unlocks = PackedStringArray("plant_press")
steps = [{"type": "pressed", "hub": "yosemite_valley", "count": 3, "objective": "Press 3 different plants on the Valley floor and show Enid Michael", "reminder": "Three different plants from the Valley floor. An oak leaf, a cedar spray, a fern. Walk up to one and take a single sprig.", "done": ["Let me see. Flat, labeled, one sprig of each. You have a careful hand.", "Now look. Lay one of yours on an old sheet, and there: it sits inside a faint outline. Somebody traced what belonged on each sheet and never filled it."]}]
outro = PackedStringArray("Nobody at the Museum knows who this Guardian was. Not Mr. Clark, he says. We've taken to calling them the lost Guardian.", "Ranger Hodges keeps the files at the ranger station. If anyone has a name, she does. Take her some specimens: she's wanted a station herbarium for years.")
reward_items = {"dried_apples": 2}
