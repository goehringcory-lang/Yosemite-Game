[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "degnan_bread"
title = "Bread for the Valley"
giver = "bridget_degnan"
requires = PackedStringArray("clark_register")
intro = PackedStringArray("You there, with the book! Can you carry bread as well as you carry that?", "The climbers at Camp 4 have been living on crackers, and Mrs. Curry's cook is short-handed.", "Take a loaf to Dick Leonard at Swan Slab and another to Jennie Curry at Camp Curry. Then come back and I'll make it worth your while.")
steps = [{"type": "talk", "target": "dick_leonard", "objective": "Bring bread to Dick Leonard at Swan Slab", "reminder": "Dick's up at Swan Slab, behind Camp 4. Follow the sound of people arguing about ropes.", "done": ["Bread from Degnan's? Tell Bridget she's saved the whole Rock Climbing Section."]}, {"type": "talk", "target": "jennie_curry", "objective": "Bring bread to Jennie Curry at Camp Curry", "reminder": "Camp Curry is at the east end of the valley, below Glacier Point.", "done": ["Bless her. Tell Bridget our starter's gone flat, and we'd pay a king's ransom for a jar of hers."]}, {"type": "return", "objective": "Go back to Bridget Degnan", "reminder": "Back to the bakery with you.", "done": ["Gone flat, has it? Then she'll want some of mine."]}]
outro = PackedStringArray("Here: three loaves for your pack, and a jar of my starter for Mrs. Curry.", "Keep the starter warm and don't let it spill. It's older than some of those climbers.")
reward_items = {"degnan_loaf": 3, "sourdough_starter": 1}
