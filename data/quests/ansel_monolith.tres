[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/story/quest_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "ansel_monolith"
title = "Monolith"
giver = "ansel_adams"
requires = PackedStringArray("eichorn_apron")
intro = PackedStringArray("Half Dome's face catches the afternoon light for about an hour. I took a picture of it once from the Diving Board, and I nearly didn't get it.", "You can't really see this valley from the floor. Get up on the rim, look across at Half Dome, and then come tell me what you saw.", "Jules Eichorn was my piano student, you know. Now he's teaching me about ropes.")
steps = [{"type": "climbed", "route": "glacier_point_apron", "objective": "Climb the Glacier Point Apron to the rim", "reminder": "The Apron's the way up. Look at the light while you're on it.", "done": ["You went up! Tell me what it looked like."]}, {"type": "return", "objective": "Tell Ansel Adams what you saw", "reminder": "Come find me at Best's Studio when you've been to the rim.", "done": ["Big, and quiet, and it keeps changing. Yes. That's the whole trouble with photographing it."]}]
outro = PackedStringArray("Take these quickdraws. I had them for a Sierra Club outing and never used them. Better on your harness than in my darkroom.")
reward_gear = {"quickdraw": 2}
