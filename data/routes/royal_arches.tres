[resource]
script = ExtResource("1_route")
id = "royal_arches"
display_name = "Royal Arches"
grade = "5.7 A0, 16 pitches"
description = "A long, wandering climb up the huge granite arches behind the Ahwahnee to the north rim. The last pitches are a famous friction traverse."
first_ascent = "Morgan Harris, Kenneth Adam, and Hervey Voge, 1936"
