[gd_resource type="Resource" script_class="RouteData" format=3]

[ext_resource type="Script" path="res://scripts/climb/route_data.gd" id="1_route"]

[resource]
script = ExtResource("1_route")
id = "the_nose"
display_name = "The Nose"
grade = "VI 5.13+, 31 pitches (5.9 C2 with aid)"
description = "The prow of El Capitan: three thousand feet of cracks, pendulums, and roofs. Harding nailed and bolted his way up it in 1958. Climbed free, with only hands and feet doing the work, it is the top of the grade scale: the Great Roof and the Changing Corners are both 5.13."
first_ascent = "Warren Harding, Wayne Merry, and George Whitmore, 1958 (aid, 45 days over 18 months). First free ascent 1993"
required_gear = {"rope": 1, "harness": 1, "cam": 10, "quickdraw": 6, "aiders": 2, "ascenders": 2, "haul_bag": 1, "portaledge": 1}
pitches = Array[int]([4, 4, 5, 4, 5, 5, 5, 4, 4])
moves_per_pitch = 9
nights = 2
guide_chapter = "El Capitan"
guide_order = 50
guide_tip = "The top of the tick list. Two nights on the wall: pack a real meal for each. The Great Roof and the Changing Corners are the cruxes."
height_ft = 3000
