; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valley Days"
config/description="A cozy pixel exploration game set in Yosemite National Park."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://scripts/autoload/game_clock.gd"
Inventory="*res://scripts/autoload/inventory.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Park="*res://scripts/autoload/park.gd"
FoodDB="*res://scripts/story/food_db.gd"
Gear="*res://scripts/story/gear.gd"
Granary="*res://scripts/story/granary.gd"
Recipes="*res://scripts/story/recipes.gd"
Cooking="*res://scripts/story/cooking.gd"
QuestLog="*res://scripts/story/quest_log.gd"
Larder="*res://scripts/story/larder.gd"
Perks="*res://scripts/story/perks.gd"
Friendship="*res://scripts/story/friendship.gd"
Herbarium="*res://scripts/story/herbarium.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/theme.tres"

