script = ExtResource("info")
title = "Tuolumne Meadows"
text = "Elevation 8,600 feet. The largest subalpine meadow in the Sierra Nevada, ringed by lodgepole pine and granite domes. Snow covers it half the year; the Tioga Road over it is closed from about November to May or June."

