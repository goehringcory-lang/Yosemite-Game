script = ExtResource("4_r")
title = "A house on the hill"
text = "A little green house on the knoll above the market, with a brown picket fence and a bay window. Through the living room window someone in a flannel shirt is hunched over a laptop. On its screen is a tiny pixel valley: a granite wall, pines, the river, and somebody small walking the trail. A sticky note on the lid says VALLEY DAYS."
extra_text = "It's late, and the laptop is still on. The mug has been empty for hours. \"One more fix,\" someone says inside, to nobody."
extra_hours = Vector2i(22, 2)

