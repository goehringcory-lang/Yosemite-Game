position = Vector2(486, 626)
collision_mask = 0
script = ExtResource("20_r")
title = "Camp 4 Rescue Site"
text = "SAR: the search and rescue site. The volunteers who live in these tent cabins answer the park's rescue calls: lost hikers, injuries on the trails, and parties stuck on the walls. They wear yellow team shirts in the field. Volunteers who can hold a rope are always wanted: ask Jo Tolliver at the cache."

