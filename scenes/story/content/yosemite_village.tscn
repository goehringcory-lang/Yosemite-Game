script = ExtResource("sar_info")
title = "SAR tent cabin"
text = "A canvas tent cabin on a plank platform, with a wood stove and a number by the door. Yosemite's search and rescue volunteers live in a row of these at the back of Camp 4 through the season, rent free, in return for being on call for the park's rescues."

