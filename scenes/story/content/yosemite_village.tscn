[node name="RescueCache" type="StaticBody2D" parent="."]
position = Vector2(604, 556)
collision_mask = 0
script = ExtResource("sar_info")
title = "Rescue cache"
text = "The search and rescue cache: ropes coiled on their pegs, helmets on the shelf, rope bags, first aid kits, and the radio, which is never switched off. Whoever is on call can be out the door with all of it in a few minutes."

