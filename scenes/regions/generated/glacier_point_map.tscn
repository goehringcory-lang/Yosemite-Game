title = "Glacier Point"
text = "7,214 feet. The Valley floor is 3,200 feet below you. Across the canyon rise Half Dome, Vernal and Nevada Falls, and the peaks of the High Sierra."

[node name="Sign_The_Firefall" type="StaticBody2D" parent="Objects" unique_id=1679325941 instance=ExtResource("4_km3s7")]
position = Vector2(1000, 1068)
collision_mask = 0
script = ExtResource("5_pnav6")
title = "The Firefall"
text = "On summer nights from 1872 to 1968, glowing embers were pushed off this cliff to fall like a waterfall of fire. The Park Service ended it because it wasn't a natural event."

[node name="Sign_Glacier_Point_Hotel" type="StaticBody2D" parent="Objects" unique_id=447038793 instance=ExtResource("4_km3s7")]
position = Vector2(968, 1068)
collision_mask = 0
script = ExtResource("5_pnav6")
title = "Glacier Point Hotel"
text = "A hotel stood on this point until it burned in 1969."

[node name="Sign_Washburn_Point" type="StaticBody2D" parent="Objects" unique_id=1689666715 instance=ExtResource("4_km3s7")]
