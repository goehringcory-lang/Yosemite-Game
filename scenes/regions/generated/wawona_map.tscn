[node name="Sign_Wawona_Hotel" parent="Objects" unique_id=544210696 instance=ExtResource("4_lvl7k")]
position = Vector2(776, 780)
title = "Wawona Hotel"
text = "The main building opened in 1879. Guests first arrived here by stagecoach. The hotel is a National Historic Landmark."

[node name="Sign_Clarks_Station" parent="Objects" unique_id=797416046 instance=ExtResource("4_lvl7k")]
position = Vector2(728, 764)
title = "Clark's Station"
text = "Galen Clark homesteaded here in 1856 and kept a way station for travelers. In 1866 he became the first Guardian of the Yosemite Grant."

[node name="Sign_Wawona_Covered_Bridge" parent="Objects" unique_id=482854592 instance=ExtResource("4_lvl7k")]
position = Vector2(776, 700)
title = "Wawona Covered Bridge"
text = "Galen Clark built a bridge across the South Fork here in 1857. The Washburn brothers, who ran the hotel, covered it in 1875."

[node name="Sign_Yosemite_History_Center" parent="Objects" unique_id=845106761 instance=ExtResource("4_lvl7k")]
position = Vector2(712, 668)
title = "Yosemite History Center"
text = "These cabins and buildings were moved here from around the park to tell the story of its early years."

[node name="Sign_Mariposa_Grove" parent="Objects" unique_id=88606656 instance=ExtResource("4_lvl7k")]
position = Vector2(1560, 1964)
title = "Mariposa Grove"
text = "About 500 mature giant sequoias grow in this grove, the largest in Yosemite. It was protected in 1864, together with Yosemite Valley, in the Yosemite Grant."

[node name="Sign_Grizzly_Giant" parent="Objects" unique_id=1382390098 instance=ExtResource("4_lvl7k")]
position = Vector2(2472, 2076)
title = "Grizzly Giant"
text = "One of the oldest sequoias in the grove, estimated at about 2,000 years old, and around 209 feet tall."

[node name="Sign_California_Tunnel_Tree" parent="Objects" unique_id=438524121 instance=ExtResource("4_lvl7k")]
position = Vector2(2504, 2044)
title = "California Tunnel Tree"
text = "A tunnel was cut through this living sequoia in 1895 so stagecoaches could drive through. The tree is still alive, and you can walk through it."

