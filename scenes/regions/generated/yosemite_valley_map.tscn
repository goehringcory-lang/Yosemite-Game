[node name="Objects" type="Node2D" parent="." unique_id=985322118]
y_sort_enabled = true

[node name="Sign_Yosemite_Valley" parent="Objects" unique_id=544210696 instance=ExtResource("4_plp7l")]
position = Vector2(6160, 1240)
title = "Yosemite Valley"
text = "Glaciers and the Merced River carved this valley, about seven miles long and a mile wide. Its granite walls rise 3,000 feet and more above a floor near 4,000 feet."

[node name="Sign_Yosemite_Falls" parent="Objects" unique_id=1215118689 instance=ExtResource("4_plp7l")]
position = Vector2(5488, 1176)
title = "Yosemite Falls"
text = "From top to bottom, Yosemite Falls drops 2,425 feet in three parts. It roars in late spring with snowmelt and can dry to a trickle by late summer."

[node name="Sign_Lower_Yosemite_Fall" parent="Objects" unique_id=717276297 instance=ExtResource("4_plp7l")]
position = Vector2(5360, 952)
title = "Lower Yosemite Fall"
text = "Lower Yosemite Fall drops 320 feet. Above it are the middle cascades and Upper Yosemite Fall, which alone falls 1,430 feet."

[node name="Sign_El_Capitan" parent="Objects" unique_id=2050137884 instance=ExtResource("4_plp7l")]
position = Vector2(3216, 3064)
title = "El Capitan"
text = "El Capitan rises about 3,000 feet from the Valley floor. Climbers first reached the top by the Nose in 1958, after 47 days of climbing spread over 18 months."

[node name="Sign_Tunnel_View" parent="Objects" unique_id=1952581337 instance=ExtResource("4_plp7l")]
position = Vector2(272, 3704)
title = "Tunnel View"
text = "This view opened with the Wawona Tunnel in 1933. El Capitan stands on the left, Bridalveil Fall on the right, and Half Dome in the distance."

[node name="Sign_Bridalveil_Fall" parent="Objects" unique_id=263818919 instance=ExtResource("4_plp7l")]
position = Vector2(2128, 3512)
title = "Bridalveil Fall"
text = "Bridalveil Fall drops 620 feet and flows all year. On windy days its spray blows sideways across the cliff."

[node name="Sign_The_Merced_River" parent="Objects" unique_id=290762935 instance=ExtResource("4_plp7l")]
position = Vector2(5168, 2008)
title = "The Merced River"
text = "The Merced flows from the high country through the Valley and on to the San Joaquin River. Congress named it a Wild and Scenic River in 1987."

[node name="Sign_Camp_4" parent="Objects" unique_id=1051218507 instance=ExtResource("4_plp7l")]
position = Vector2(5008, 1528)
title = "Camp 4"
text = "Climbers have camped here since the 1950s, the golden age of big-wall climbing. Camp 4 was added to the National Register of Historic Places in 2003."

[node name="Sign_Curry_Village" parent="Objects" unique_id=1320095308 instance=ExtResource("4_plp7l")]
position = Vector2(6928, 1912)
title = "Curry Village"
text = "David and Jennie Curry opened Camp Curry here in 1899 with just seven tents."

[node name="Sign_Glacier_Point_Apron" parent="Objects" unique_id=1870925923 instance=ExtResource("4_plp7l")]
position = Vector2(6704, 2072)
title = "Glacier Point Apron"
text = "Smooth, low-angle granite slabs sweep up from here toward Glacier Point. The rim is 3,200 feet above you."

[node name="Sign_Happy_Isles" parent="Objects" unique_id=1527282740 instance=ExtResource("4_plp7l")]
position = Vector2(7824, 2296)
title = "Happy Isles"
text = "The John Muir Trail starts here and runs about 211 miles to the summit of Mount Whitney."

[node name="Sign_Mirror_Lake" parent="Objects" unique_id=1530766941 instance=ExtResource("4_plp7l")]
position = Vector2(8240, 1080)
title = "Mirror Lake"
text = "Tenaya Creek forms this seasonal lake below Half Dome. It is slowly filling with sand and gravel, and by late summer it is often a meadow."

[node name="Sign_The_Ahwahnee" parent="Objects" unique_id=1610986659 instance=ExtResource("4_plp7l")]
position = Vector2(6768, 1272)
title = "The Ahwahnee"
text = "The Ahwahnee opened in 1927. To resist fire, its builders used stone and concrete stained to look like redwood."

[node name="Sign_Yosemite_Valley_Chapel" parent="Objects" unique_id=2010226883 instance=ExtResource("4_plp7l")]
position = Vector2(5680, 1656)
title = "Yosemite Valley Chapel"
text = "The chapel was built in 1879 and moved to this spot in 1901."

[node name="Sign_Lamon_Orchard" parent="Objects" unique_id=1930126042 instance=ExtResource("4_plp7l")]
position = Vector2(7184, 2104)
title = "Lamon Orchard"
