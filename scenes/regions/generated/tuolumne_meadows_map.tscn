[node name="Sign_Tuolumne_Meadows" parent="Objects" unique_id=544210696 instance=ExtResource("4_p54e3")]
position = Vector2(1336, 1100)
title = "Tuolumne Meadows"
text = "8,600 feet. One of the largest high-elevation meadows in the Sierra Nevada. Snow covers it for much of the year."

[node name="Sign_Soda_Springs" parent="Objects" unique_id=231057150 instance=ExtResource("4_p54e3")]
position = Vector2(1592, 764)
title = "Soda Springs"
text = "Cold, naturally carbonated water bubbles up here. Jean-Baptiste Lembert homesteaded this spot in 1885."

[node name="Sign_Parsons_Memorial_Lodge" parent="Objects" unique_id=1724880583 instance=ExtResource("4_p54e3")]
position = Vector2(1544, 780)
title = "Parsons Memorial Lodge"
text = "The Sierra Club built this lodge of local granite in 1915, in memory of club leader Edward Taylor Parsons."

[node name="Sign_Lembert_Dome" parent="Objects" unique_id=1444877667 instance=ExtResource("4_p54e3")]
position = Vector2(2552, 780)
title = "Lembert Dome"
text = "Glaciers flowing west over Lembert Dome smoothed its gentle eastern side and plucked its western face into a steep cliff."

[node name="Sign_Tuolumne_River" parent="Objects" unique_id=548564895 instance=ExtResource("4_p54e3")]
position = Vector2(1976, 812)
title = "Tuolumne River"
text = "The Dana and Lyell forks meet near here, carrying snowmelt from Mount Dana and Mount Lyell west toward Hetch Hetchy."

