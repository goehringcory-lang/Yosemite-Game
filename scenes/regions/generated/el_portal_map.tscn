[node name="Sign_Yosemite_Valley_Railroad" parent="Objects" unique_id=544210696 instance=ExtResource("4_iga3b")]
position = Vector2(904, 1084)
title = "Yosemite Valley Railroad"
text = "From 1907 to 1945, trains ran 78 miles from Merced up the Merced River canyon to El Portal. Travelers rode the last miles into the Valley by stage, and later by bus."

[node name="Sign_Arch_Rock" parent="Objects" unique_id=1550727991 instance=ExtResource("4_iga3b")]
position = Vector2(2696, 572)
title = "Arch Rock"
text = "The road squeezes between two huge fallen boulders here. This entrance opened in 1926 with the All-Year Highway, today's Highway 140."

[node name="Sign_El_Portal_Market" parent="Objects" unique_id=1825501874 instance=ExtResource("4_iga3b")]
position = Vector2(1032, 1116)
title = "El Portal Market"
text = "Groceries, supplies, and gas. There is no gas station in Yosemite Valley, 15 miles up the road."

[node name="Sign_Merced_River_Canyon" parent="Objects" unique_id=908262321 instance=ExtResource("4_iga3b")]
position = Vector2(1128, 1148)
title = "Merced River Canyon"
text = "Between Yosemite Valley and El Portal, the Merced River drops about 2,000 feet through the narrow Merced Gorge."

