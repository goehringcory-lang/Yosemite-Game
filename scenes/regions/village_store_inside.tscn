script = ExtResource("15_e45mt")
title = "Keep bears wild"
text = "A carved bear is the only kind you should get this close to. Real black bears in Yosemite can smell food in a parked car, so food goes in a bear locker, and a bear you meet in the wild gets at least 50 yards, half a football field, between you."

