[node name="CablesSign" type="StaticBody2D" parent="Entities" unique_id=1681157148]
position = Vector2(1072, 1344)
collision_mask = 0
script = ExtResource("6_l3ub7")
title = "The cables"
text = "Two steel cables on posts, 400 feet up the back of the Dome at about 45 degrees, with a wooden board across the rock at each pair of posts. The Sierra Club put up the first cables in 1919, following the line of George Anderson's eyebolts. Rangers put the posts up in late May and take them down in October. Never go up in a storm: the cables draw lightning."

