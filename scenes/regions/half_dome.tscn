position = Vector2(656, 1536)
collision_mask = 0
script = ExtResource("6_l3ub7")
title = "Sub Dome"
text = "Granite steps cut and stacked up the bare back of Sub Dome, the last climb before the cables. A ranger checks permits at its foot in summer."

