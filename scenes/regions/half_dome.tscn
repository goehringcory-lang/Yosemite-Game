[node name="VisorSign" type="StaticBody2D" parent="Entities" unique_id=1029033120]
position = Vector2(720, 128)
collision_mask = 0
script = ExtResource("6_l3ub7")
title = "The Visor"
text = "The lip of the face juts out over the drop here like the brim of a cap. Stay back from the edge: there's nothing below it for 2,000 feet."

