[node name="SummitSign" type="StaticBody2D" parent="Entities" unique_id=1487990921]
position = Vector2(1104, 288)
collision_mask = 0
script = ExtResource("6_l3ub7")
title = "Half Dome"
text = "8,842 feet, and nearly flat on top: about 13 acres of bare granite. The northwest face drops 2,000 feet from the lip, straight down to Tenaya Canyon. George Anderson stood here first, in October 1875, at the top of the eyebolts he drilled up the back."

