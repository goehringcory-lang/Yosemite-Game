script = ExtResource("5_7py8n")
title = "Big Oak Flat Road Junction"
text = "Straight on, El Portal Road (Highway 140) follows the Merced down its canyon to El Portal. Turn right for Big Oak Flat Road (Highway 120): up the canyon wall to Crane Flat, where the Tioga Road leaves for Tuolumne Meadows."

