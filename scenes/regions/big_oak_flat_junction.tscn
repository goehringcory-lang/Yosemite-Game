[node name="BigOakFlatSign" type="StaticBody2D" parent="Entities" unique_id=1519791465]
position = Vector2(1424, 576)
collision_mask = 0
script = ExtResource("5_7py8n")
title = "Big Oak Flat Road"
text = "A wagon road from the gold country reached the Valley this way in 1874. The road you drive today was built in 1940, through three tunnels blasted in the canyon wall."

