[node name="ExfoliationSign" type="StaticBody2D" parent="Entities" unique_id=77212995]
position = Vector2(688, 736)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Sheets of granite"
text = "Look for curved slabs peeling off the dome like the layers of an onion. Granite that cooled deep underground swells as the rock above it wears away, and cracks off in shells parallel to its surface. That is how the domes got their shape."

