[node name="TenayaLakeSign" type="StaticBody2D" parent="Entities" unique_id=1338718793]
position = Vector2(1936, 992)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Tenaya Lake"
text = "8,150 feet. The ice that flowed down from Tuolumne Meadows scoured this basin out of solid granite, and the lake filled it when the glacier melted. Tenaya Creek leaves its west end and runs down Tenaya Canyon all the way to Mirror Lake in the Valley."

[node name="Sprite" type="Sprite2D" parent="Entities/TenayaLakeSign" unique_id=1842108598]
