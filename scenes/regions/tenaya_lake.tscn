position = Vector2(1040, 1056)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Sunrise Lakes Trailhead"
text = "Across Tenaya Creek and up the granite: about 3.5 miles to the Sunrise Lakes and 5 to Sunrise High Sierra Camp, or about 7 south to the top of Clouds Rest. The John Muir Trail passes Sunrise on its way from the Valley to Tuolumne Meadows."

