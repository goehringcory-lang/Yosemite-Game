[node name="ErraticsSign" type="StaticBody2D" parent="Entities" unique_id=845611121]
position = Vector2(272, 512)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Glacial erratics"
text = "The boulders lying loose on this bare dome rode here on the ice. The glacier that filled Tenaya Canyon dragged them from the high country to the east, polished the granite under them, and melted away about 15,000 years ago, setting them down where they stand."

