[node name="TenayaCreekOutletSign" type="StaticBody2D" parent="Entities" unique_id=847139726]
position = Vector2(944, 640)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Tenaya Creek"
text = "The lake's outlet. In early summer the snowmelt pours out deep and cold here; by fall you can step across on the rocks."

