[node name="OlmstedPointSign" type="StaticBody2D" parent="Entities" unique_id=589215563]
position = Vector2(560, 256)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Olmsted Point"
text = "8,400 feet. Down Tenaya Canyon to the south, Clouds Rest's long granite back, and past its shoulder the far side of Half Dome, rounded where the Valley sees it sheer. Named for Frederick Law Olmsted, who chaired the first commission to manage Yosemite in 1864, and his son, who served on the park's advisory board."

