[node name="PollyDomeSign" type="StaticBody2D" parent="Entities" unique_id=1517471216]
position = Vector2(1552, 1248)
collision_mask = 0
script = ExtResource("7_fkdpe")
title = "Polly Dome and Stately Pleasure Dome"
text = "The bare domes above the road on the lake's north side. Stately Pleasure Dome rises straight out of the water beside the road, and its slabs have been climbed since the 1960s. Pywiack Dome stands alone past the lake's east end."

