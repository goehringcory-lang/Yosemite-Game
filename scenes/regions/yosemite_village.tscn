[node name="IndianVillageSign" type="StaticBody2D" parent="Entities" unique_id=184726658]
position = Vector2(1968, 600)
collision_mask = 0
script = ExtResource("5_58pbq")
title = "Indian Village"
text = "This village behind the Yosemite Museum shows how Native families lived in the Valley: bark homes, acorn granaries, and grinding rocks worn into the granite. The Southern Sierra Miwuk and neighboring peoples still live and work in and around Yosemite today."

