script = ExtResource("5_u8m40")
title = "Midnight Lightning"
text = "The chalk lightning bolt marks Midnight Lightning, the boulder problem up this overhanging face. Ron Kauk made the first ascent in 1978. Graded V8, it was one of the hardest boulder problems in the world, and the mantel onto the top still turns most climbers back. Climbers keep the bolt redrawn."

