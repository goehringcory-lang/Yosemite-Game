script = ExtResource("5_d27f1")
title = "Camp 4"
text = "Climbers have camped here since the 1950s, the golden age of big-wall climbing, when Royal Robbins, Warren Harding and their friends lived here for whole seasons. In the late 1990s climbers fought a plan to build lodging on the site, and Camp 4 was added to the National Register of Historic Places in 2003."

