script = ExtResource("5_ubl06")
title = "Bear canisters"
text = "Black bears in Yosemite learned long ago that people mean food. In the wilderness you carry your food, toiletries and trash in a hard-sided canister a bear can't open, and keep it well away from your tent at night. A bear that gets human food once keeps coming back for more."

