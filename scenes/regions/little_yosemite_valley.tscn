position = Vector2(1168, 704)
collision_mask = 0
script = ExtResource("6_7l477")
title = "Bears and your food"
text = "Black bears know this camp. Every scrap of food, trash and anything that smells (toothpaste too) goes in a bear canister at night, set well away from your tent. A bear that gets people's food once keeps coming back for it."

