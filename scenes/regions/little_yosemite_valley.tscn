[node name="LittleYosemiteSign" type="StaticBody2D" parent="Entities" unique_id=397181014]
position = Vector2(784, 704)
collision_mask = 0
script = ExtResource("6_7l477")
title = "Little Yosemite Valley"
text = "6,100 feet. Above Nevada Fall the Merced runs slow and sandy through a little valley of its own, carved by the same glaciers as the big one below. Half Dome's back rises over the north side. Backpackers camp here on the way to the Dome and the high country."

