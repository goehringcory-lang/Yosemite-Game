script = ExtResource("6_jwus6")
title = "Ahwahnee Meadow"
text = "The Ahwahneechee lived in villages along the Valley's meadows, gathering acorns from the black oaks. Park staff now burn the meadows now and then, as they did, to keep the conifers from taking over."

