script = ExtResource("8_1wt5o")
title = "Glacier Point"
text = "7,214 feet. The Valley floor is 3,200 feet straight down. Across the canyon: Half Dome, and to its right Liberty Cap and Nevada Fall, with Vernal Fall below. Below you, Curry Village and the Merced."

