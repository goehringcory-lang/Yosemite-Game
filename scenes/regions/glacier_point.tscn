position = Vector2(2224, 384)
collision_mask = 0
script = ExtResource("8_lifbg")
title = "The Firefall"
text = "On summer nights from 1872 until 1968, glowing embers of red fir bark were pushed off this cliff, and fell like a waterfall of fire to the cheers from Camp Curry below. James McCauley of the Mountain House began it. The Park Service ended it because it wasn't a natural event."

