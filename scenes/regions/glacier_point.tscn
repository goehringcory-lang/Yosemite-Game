script = ExtResource("8_lifbg")
title = "Overhanging Rock"
text = "A slab of granite jutting out from the point, 3,000 feet above the Valley floor. In old photographs people stand, dance and even do handstands on its tip. It has been closed to visitors for years: enjoy it from behind the railing."

