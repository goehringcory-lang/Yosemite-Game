script = ExtResource("4_y7yp5")
title = "Virginia Best's piano"
text = "Ansel Adams trained as a concert pianist. On his summers in the Valley he played this piano at Best's Studio, and in 1928 he married Virginia Best, the painter Harry Best's daughter, in the studio. For years he couldn't decide between music and photography."

