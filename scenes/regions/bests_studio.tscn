script = ExtResource("4_y7yp5")
title = "Harry Best"
text = "Harry Best, a painter, opened his studio in the Valley in 1902 and sold his paintings and photographs to visitors. After Ansel and Virginia Adams took it over, it became the Ansel Adams Gallery in 1972. It is the oldest family-run business in a national park."

