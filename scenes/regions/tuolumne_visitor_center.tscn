script = ExtResource("5_4t4jj")
title = "Tuolumne's ice"
text = "A great ice cap once covered all of this, a thousand feet deep, and its glaciers flowed out of here down the Tuolumne and Merced canyons. The domes around the meadow, like Lembert and Pothole, are rounded on the side the ice came from and plucked steep on the far side."

