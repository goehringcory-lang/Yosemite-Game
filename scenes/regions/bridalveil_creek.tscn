[node name="McGurkCabin" type="StaticBody2D" parent="Entities" unique_id=1073007349]
position = Vector2(528, 1024)
collision_mask = 0
script = ExtResource("5_ujjyb")
title = "McGurk Meadow Cabin"
text = "John McGurk's log cabin, built in the 1890s at the edge of this meadow. He ran stock here in the summers, as sheepmen and cattlemen did across the high Sierra before and after the park was set aside. The roof is long gone, but the logs still stand."

