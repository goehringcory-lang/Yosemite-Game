[node name="McGurkMeadowSign" type="StaticBody2D" parent="Entities" unique_id=1723954870]
position = Vector2(624, 1152)
collision_mask = 0
script = ExtResource("5_ujjyb")
title = "McGurk Meadow"
text = "A wet subalpine meadow at about 7,000 feet. Before the park took over its care, sheep and cattle grazed these meadows each summer. Now corn lilies, shooting stars and Pacific tree frogs have it back, and mule deer graze at dusk."

