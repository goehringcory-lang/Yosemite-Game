minutes = 180
closure = "four_mile_trail"
needs_hub = "glacier_point"
locked_text = "The Four Mile Trail climbs 3,200 feet in switchbacks up the wall to Glacier Point. The rim is still ahead of you: climb the Glacier Point Apron first, and the way up opens."

