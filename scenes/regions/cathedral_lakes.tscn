[node name="CathedralLakesSign" type="StaticBody2D" parent="Entities" unique_id=551853840]
position = Vector2(1104, 512)
collision_mask = 0
script = ExtResource("7_1g7m2")
title = "Cathedral Lakes"
text = "9,288 to 9,585 feet. Two glacial tarns cupped in granite beneath the fluted spires of Cathedral Peak and Echo Peaks. The John Muir Trail climbs here out of Tuolumne Meadows on its way south to Cathedral Pass and Mount Whitney."

