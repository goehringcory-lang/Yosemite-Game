position = Vector2(720, 672)
collision_mask = 0
script = ExtResource("7_1g7m2")
title = "Cathedral Peak"
text = "10,911 feet. John Muir made the first ascent alone in September 1869, calling it 'a temple displaying Nature's best masonry and architecture.' Its sharp southeast buttress is one of the finest alpine climbs in the Sierra."

