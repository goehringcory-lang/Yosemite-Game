script = ExtResource("6_socdt")
title = "The Bracebridge Dinner"
text = "Every Christmas since 1927 the Dining Room has held the Bracebridge Dinner, a seven-course feast in the manner of an English manor's Christmas, with carols, a Lord of the Manor and a boar's head. Ansel Adams wrote and directed it from 1929 until 1973."

