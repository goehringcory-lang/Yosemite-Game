[node name="Basket1" type="StaticBody2D" parent="Entities" unique_id=710069564]
position = Vector2(480, 280)
collision_mask = 0
script = ExtResource("4_24oml")
title = "Lucy Telles's great basket"
text = "Lucy Telles, a Mono Lake Paiute and Southern Miwok weaver who lived in the Valley, spent about four years on this basket in the early 1930s. It is one of the largest baskets of its kind ever woven, with tens of thousands of stitches of sedge root, bracken fern root and redbud bark."

