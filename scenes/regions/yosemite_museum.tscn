[node name="Panel6" type="StaticBody2D" parent="Entities" unique_id=1691010956]
position = Vector2(392, 208)
collision_mask = 0
script = ExtResource("4_24oml")
title = "The museum"
text = "The Yosemite Museum opened in 1926, one of the first buildings in the National Park Service built to be a museum. Its granite ground story and dark timber were meant to sit quietly under the cliffs."

