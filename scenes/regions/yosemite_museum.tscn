[node name="Panel7" type="StaticBody2D" parent="Entities" unique_id=1624225264]
position = Vector2(568, 208)
collision_mask = 0
script = ExtResource("4_24oml")
title = "Weavers of the Valley"
text = "Ahwahneechee, Miwok and Paiute weavers made baskets for gathering, cooking and storing acorns, and for trade. In the early 1900s weavers like Lucy Telles and Carrie Bethel made fancy baskets for the Indian Field Days, and their work is kept here. (This text awaits tribal review.)"

