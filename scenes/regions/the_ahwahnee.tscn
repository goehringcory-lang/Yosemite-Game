script = ExtResource("6_8c22c")
title = "The Ahwahnee"
text = "The Ahwahnee opened in July 1927. Its architect, Gilbert Stanley Underwood, built it of granite, steel, and concrete stained to look like redwood, so that it would fit under the cliffs and never burn like the wooden hotels before it. The painted patterns on its beams and the stained glass inside were designed for it. It is a National Historic Landmark. The great doors are closed for now."

