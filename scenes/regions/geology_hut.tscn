script = ExtResource("4_xtcap")
title = "Half Dome"
text = "Through the glass, Half Dome's sheer northwest face, 2,000 feet of it, catches the afternoon sun. The glaciers never covered its top; they ground past below it and steepened the face as the rock peeled away in sheets."

