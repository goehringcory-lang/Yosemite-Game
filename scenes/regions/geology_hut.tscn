position = Vector2(128, 240)
collision_mask = 0
script = ExtResource("4_xtcap")
title = "Reading the view"
text = "The Geology Hut was built in 1924, one of the first places in any national park where visitors could stand and have the scenery explained to them. From here you can see what the glaciers left: hanging valleys, polished domes and the deep U of the Valley."

