script = ExtResource("5_cjuao")
title = "The Firefall"
text = "From 1872 to 1968, embers from a bonfire were pushed off Glacier Point at nightfall, and Camp Curry crowds cheered from below. David Curry's call went up to the rim: 'Hello, Glacier!' and then, 'Let the fire fall!' The Park Service ended the show in 1968."

