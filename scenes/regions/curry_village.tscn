position = Vector2(920, 784)
collision_mask = 0
script = ExtResource("5_h8fsh")
title = "The Firefall"
text = "Starting in the 1870s, embers from a bonfire were pushed off Glacier Point at nightfall, and Camp Curry crowds cheered from below. The show lapsed in the 1890s, and David Curry brought it back. David Curry's call went up to the rim: 'Hello, Glacier!' and then, 'Let the fire fall!' The Park Service ended it on January 25, 1968."

