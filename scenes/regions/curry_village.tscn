[node name="LedgeTrail" parent="Entities" unique_id=1872187203 instance=ExtResource("161_ledge")]
position = Vector2(1904, 352)
label = "Ledge Trail, up to Glacier Point"
target_region = "glacier_point"
target_spawn = "ledge_trail_top"
minutes = 180
needs_hub = "glacier_point"
locked_text = "The old Ledge Trail, built in 1872, climbs the gully beside the Apron straight up to Glacier Point, 3,200 feet above. Rockfall closed it for decades, and it's steep and loose. Climb the Glacier Point Apron first, and you'll know the rock well enough to try it."

