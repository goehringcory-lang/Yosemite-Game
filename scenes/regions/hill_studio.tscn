script = ExtResource("4_pltb6")
title = "Thomas Hill"
text = "Thomas Hill painted Yosemite for half a century, in canvases as big as the walls. He came to Wawona in 1886, built this studio beside the hotel his daughter's husband ran, and painted and sold his work here until he died in 1908."

