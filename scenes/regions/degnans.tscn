script = ExtResource("5_wxubq")
title = "Bridget's bread"
text = "In the 1880s Bridget Degnan began baking bread in a Dutch oven in her kitchen for the campers who came to her door. She was soon baking fifty loaves a day, then built a brick oven, and the Degnans' bakery and store grew into this place. It has fed the Valley ever since."

