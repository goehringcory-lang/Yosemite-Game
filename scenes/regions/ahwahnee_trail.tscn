script = ExtResource("6_83nn1")
title = "Stoneman Meadow"
text = "This meadow lies between the trees and the Merced River. Deer graze here at dawn and dusk, and in early summer it fills with lupine and shooting stars. Stay on the trail: meadow grasses are easily trampled."

