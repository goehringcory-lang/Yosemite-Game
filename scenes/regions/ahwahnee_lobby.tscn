[node name="Plant3" type="StaticBody2D" parent="Entities" unique_id=878696445]
position = Vector2(720, 220)
collision_mask = 0
script = ExtResource("6_xih41")
title = "The Ahwahnee"
text = "The Ahwahnee opened in July 1927. Gilbert Stanley Underwood built it of granite, steel and concrete stained to look like redwood, so it would fit under the cliffs and never burn like the wooden hotels before it. Two art historians, Phyllis Ackerman and Arthur Upham Pope, chose its decoration, and Jeannette Dyer Spencer drew its patterns from the baskets of the Valley's people."

