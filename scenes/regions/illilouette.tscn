collision_mask = 0
script = ExtResource("5_nu4kv")
title = "Panorama Trail"
text = "From Glacier Point down through red fir and Jeffrey pine, across Illilouette Creek, past Panorama Point to the top of Nevada Fall. Carry water: there is none on the ridge."

