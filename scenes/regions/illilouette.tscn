[node name="IllilouetteFallSign" type="StaticBody2D" parent="Entities" unique_id=1340757613]
position = Vector2(1424, 512)
collision_mask = 0
script = ExtResource("5_nu4kv")
title = "Illilouette Fall"
text = "370 feet. Illilouette Creek drains the Clark Range to the south-east and goes over the lip of this gorge in a single plume. It is the biggest tributary of the Merced, and its canyon was cut by its own small glaciers, not the great ice of the Valley."

