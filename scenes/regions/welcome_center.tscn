script = ExtResource("5_jdmqk")
title = "The Valley from above"
text = "A model of Yosemite Valley in relief. Glaciers deepened and widened a river canyon here into a U-shaped valley, and when the last glacier melted, a lake filled it. Sediment filled the lake in, and the flat floor you walk on is its bed."

