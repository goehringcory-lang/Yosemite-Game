position = Vector2(184, 300)
collision_mask = 0
script = ExtResource("5_jdmqk")
title = "A park for all time"
text = "In 1864 President Lincoln signed the Yosemite Grant, setting aside the Valley and the Mariposa Grove 'for public use, resort and recreation, inalienable for all time.' It was the first time any government set land aside to protect its scenery. The high country around it became a national park in 1890."

