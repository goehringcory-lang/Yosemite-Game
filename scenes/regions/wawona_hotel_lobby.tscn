script = ExtResource("5_7tdr3")
title = "The Wawona Hotel"
text = "The main hotel building opened in 1879, on the site of Galen Clark's station, where he had fed and housed travelers since the 1850s. The Washburn brothers built it up into a summer resort with a golf course, a lawn and a fountain, and the stages to the Valley stopped here."

